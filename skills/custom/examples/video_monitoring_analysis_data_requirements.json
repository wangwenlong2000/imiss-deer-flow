            "skill": "density-aggregation-event",
            "target_labels": ["car", "bus", "truck", "motorcycle"],
            "roi_types": ["vehicle_lane"],
            "min_count": 8,
            "min_duration_seconds": 20
          },
          {
            "skill": "temporal-persistence-event",
            "target_labels": ["car", "bus", "truck"],
            "movement_states": ["stationary"],
            "min_duration_seconds": 20
          }
        ],
        "score_policy": {
          "min_score": 0.6
        }
      },
      "pedestrian_intrusion": {
        "event_type": "pedestrian_intrusion",
        "severity": "high",
        "join_policy": "any_required",
        "methods": [
          {
            "skill": "spatial-occupancy-event",
            "target_labels": ["person"],
            "roi_types": ["restricted_area"],
            "min_confidence": 0.5
          }
        ],
        "score_policy": {
          "min_score": 0.5
        }
      }
    },
    "object_label_taxonomy": {
      "person": "行人或人员",
      "car": "小汽车",
      "bus": "公交车或大巴",
      "truck": "货车",
