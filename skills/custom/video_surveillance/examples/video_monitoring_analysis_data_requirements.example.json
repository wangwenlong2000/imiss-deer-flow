{
  "_example": true,
  "_example_notice": "占位示例，仅用于说明所需数据的字段结构。其中的摄像头编号、地点、拍摄时间、ROI 坐标、检测框、事件候选全部是编造的占位值，与任何真实视频无关。禁止把本文件的任何取值写进分析报告、证据包或最终回答。真实视频的元数据只能来自 video-stream-ingestion 的实测输出，事件结论只能来自 single-video-event-analysis 对真实审帧的判断。",
  "schema_name": "video_monitoring_analysis_data_requirements",
  "schema_version": "2.0.0",
  "purpose": "说明当前视频监控分析架构所需的数据：事件检测统一由 single-video-event-analysis 抽帧后交给 LLM 审图；YOLO 只作为目标检测，不作为事件判断依据。",
  "minimum_input_package": {
    "video": {
      "video_path": "<替换为真实视频路径>",
      "source_type": "local_file",
      "camera_id": "<替换为真实摄像头编号，缺失时留空而不是编造>",
      "timezone": "Asia/Shanghai",
      "shooting_started_at": "<替换为真实拍摄时间，不得沿用本示例>"
    },
    "analysis_request": {
      "analysis_mode": "single_video_llm_review",
      "target_events": [
        "traffic_congestion",
        "fight",
        "fall_down",
        "traffic_accident",
        "pedestrian_intrusion",
        "smoke_or_fire",
        "crowd_gathering",
        "illegal_occupation",
        "other_abnormal_event"
      ],
      "sampling_strategy": {
        "coarse_fps": 1.0,
        "dense_fps": 4.0,
        "scene_threshold": 0.3,
        "dense_window": 2.0,
        "max_frames": 2000
      }
    }
  },
  "optional_context_data": {
    "camera": {
      "name": "<替换为真实摄像头名称，缺失时留空而不是编造>",
      "location": {
        "province": "<替换为真实省份，缺失时留空而不是编造>",
        "city": "<替换为真实城市，缺失时留空而不是编造>",
        "district": "<替换为真实区县，缺失时留空而不是编造>",
        "address": "<替换为真实地址，缺失时留空而不是编造>"
      },
      "mounting": {
        "height_meters": 6.5,
        "direction_degrees": 90,
        "view_description": "覆盖人行横道、机动车道和路口中心区域"
      }
    },
    "roi_definitions": [
      {
        "id": "ROI_CROSSWALK_001",
        "name": "北侧人行横道",
