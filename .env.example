# Copy to .env locally. Never commit .env.
# Set deployment URLs supplied by your DeerFlow administrator.
DEERFLOW_API_URL=https://YOUR-DEERFLOW-HOST/REPLACE_WITH_MOBILE_RUN_ENDPOINT
DEERFLOW_PUBLIC_BASE_URL=https://YOUR-BROWSER-ACCESSIBLE-DEERFLOW-FILE-BASE
DEERFLOW_STREAM=true
DEERFLOW_TIMEOUT=1800
DEERFLOW_ENSURE_TIMEOUT=120
DEERFLOW_UPLOAD_TIMEOUT=600
DEERFLOW_PREVIEW_TIMEOUT=120
ONECITY_DEERFLOW_IDENTITY_CLASS_MAP={}
ONECITY_DEERFLOW_ROLE_PERMISSIONS={}
ONECITY_SELF_REGISTER_ROLE_CODE=common

# Generate a unique random value for every deployment; do not reuse a sample.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET

# Internal service listeners. These are not public host mappings.
ONECITY_APP_PORT=REPLACE_WITH_LOCAL_APP_PORT
ONECITY_DEBUG=false
A2A_LLM_PORT=REPLACE_WITH_LOCAL_LLM_AGENT_PORT
A2A_INTENT_PORT=REPLACE_WITH_LOCAL_INTENT_AGENT_PORT
A2A_PLANNING_PORT=REPLACE_WITH_LOCAL_PLANNING_AGENT_PORT
A2A_ACTOR_PORT=REPLACE_WITH_LOCAL_ACTOR_AGENT_PORT
A2A_FEEDBACK_PORT=REPLACE_WITH_LOCAL_FEEDBACK_AGENT_PORT
A2A_COORDINATOR_PORT=REPLACE_WITH_LOCAL_COORDINATOR_PORT
ONECITY_PUBLIC_HTTP_PORT=REPLACE_WITH_LOCAL_REVERSE_PROXY_PORT

# Browser development proxy targets; keep these local to the developer machine.
ONECITY_BACKEND_URL=http://127.0.0.1:${ONECITY_APP_PORT}
ONECITY_COORDINATOR_URL=http://127.0.0.1:${A2A_COORDINATOR_PORT}
