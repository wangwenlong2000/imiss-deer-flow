# TAVILY API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Jina API Key
JINA_API_KEY=your-jina-api-key

# InfoQuest API Key
DASHSCOPE_API_KEY=your-dashscope-api-key
# Optional:
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# MINIMAX_API_KEY=your-minimax-api-key  # OpenAI-compatible, see https://platform.minimax.io
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional:
# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=imiss-deer-flow

# Local per-thread JSONL run event logs
DEERFLOW_RUN_EVENT_LOG_ENABLED=1
DEERFLOW_RUN_EVENT_LOG_DIR=/home/gaozhuohui/imiss-deer-flow-main/logs/run_events
# CORS Origins (comma-separated) - e.g., http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=http://localhost:3000



# ============================================================================
# Network Traffic RAG - Elasticsearch。用于RAG的数据库和索引
# ============================================================================
# Smoke test index first, then switch to production index after validation

BAIDU_AK=your_baidu_ak_here
ES_URL=http://172.17.0.1:3128
ES_USER=citybrain-street
ES_USERNAME=citybrain-street
ES_PASSWORD=your_es_password_here
LAW_REGULATIONS_ES_INDEX=cn_law_articles
LAW_REGULATIONS_ES_VECTOR_FIELD=vector-text-embedding-v4
SKILL_ROUTER_ES_INDEX=citybrain-skill-router-cards



# Network Traffic RAG - Embedding Service
# Local bge-m3 service doesn't validate the API key; "unused" is sufficient.
# Switch to a real key when using cloud providers (OpenAI, DashScope, etc.)
# 现在是提供的在线bge-m3服务来进行RAG的Embedding，后续可以切换其他云服务商的embedding服务，切换时需要修改base_url和api_key。
EMBEDDING_API_KEY=unused
EMBEDDING_BASE_URL=http://192.168.200.1:7799/v1

# SkillRouter services only
SKILLROUTER_EMBEDDING_BASE_KEY=unused
SKILLROUTER_EMBEDDING_BASE_URL=http://192.168.200.1:7800/v1

SKILLROUTER_RERANKER_BASE_KEY=unused
SKILLROUTER_RERANKER_BASE_URL=http://192.168.200.1:7801/v1

# Optional:
# LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=deer-flow
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

