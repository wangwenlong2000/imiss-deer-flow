入文档数 | 3 |\n| 失败文档数 | 0 |\n\n### 处理的视频文档：\n1. `video-traffic-agent-test` - 5145 字符嵌入文本\n2. `video-metadata-only-smoke` - 765 字符嵌入文本\n3. `video-traffic-skill-smoke` - 3441 字符嵌入文本\n\n**结论**：`video-embedding-index` skill 真链路测试通过，Agent 能够正确调用该 skill 并生成预期的向量索引结果。","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":296,"prompt_tokens":11700,"total_tokens":11996,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":0,"rejected_prediction_tokens":null,"text_tokens":296},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":11700}},"model_provider":"openai","model_name":"qwen3.5-plus","system_fingerprint":null,"id":"chatcmpl-4e71a546-f909-9a08-a5e6-1d3555320916","finish_reason":"stop","logprobs":null},"type":"ai","name":null,"id":"lc_run--019e8264-ee12-7a51-90db-fa78026999d6-0","tool_calls":[],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":11700,"output_tokens":296,"total_tokens":11996,"input_token_details":{},"output_token_details":{"reasoning":0}}}],"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/8171a60b-9a38-4f6f-bfe3-5c174a9fa182/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/8171a60b-9a38-4f6f-bfe3-5c174a9fa182/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/8171a60b-9a38-4f6f-bfe3-5c174a9fa182/user-data/outputs"},"artifacts":[],"viewed_images":{}}

