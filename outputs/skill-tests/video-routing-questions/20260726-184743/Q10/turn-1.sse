cooccurrence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"extract_stay_points","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"forecast_region_flow","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"fuse_spatial_evidence","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"map_spatial_grid","role":"supporting","score":1.0,"reason":null},{"id":"measure_spatiotemporal_entropy","role":"supporting","score":1.0,"reason":null},{"id":"mine_trajectory_patterns","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"predict_next_location","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"profile_urban_region","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"search_similar_trajectory","role":"supporting","score":1.0,"reason":null},{"id":"search_spatiotemporal","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:20c546fa-8619-4965-a935-102979858604"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"allowed_tool_names":[]}

event: values
data: {"messages":[{"content":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"20c546fa-8619-4965-a935-102979858604"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_event_impact</name>\n      <description>Use this skill when the user wants to evaluate the impact of an external event such as rainstorm, sports event, traffic control, holiday, emergency, or policy intervention on regional trajectory volume.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_event_impact/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_od_flow</name>\n      <description>Use this skill when the user asks for OD flow analysis, origin-destination matrices, commute corridors, migration routes, or region-to-region movement aggregation from staypoints.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_od_flow/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_region_heat</name>\n      <description>Use this skill when the user wants to compute regional activity heat, check-in volume, point density, unique users, or Top-K active geohash regions from trajectory records.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_region_heat/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_spatiotemporal_accessibility</name>\n      <description>Use this skill when the user asks to compute trajectory-based isochrones, reachable areas, travel-time accessibility, radiation range, or real mobility coverage from a starting geohash.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_spatiotemporal_accessibility/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>anonymize_trajectory_data</name>\n      <description>Use this skill when the user asks to anonymize, desensitize, privacy-protect, differentially perturb, k-anonymize, hash user IDs, grid-generalize, or prepare sensitive GPS/check-in trajectory data before retrieval or LLM analysis.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/anonymize_trajectory_data/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>classify_trajectory_state</name>\n      <description>Use this skill when the user wants to classify each user's trajectory into motion states such as stationary, directed migration, frequent circulation, random walk, cruising, long-stay, or semantic mobility behavior.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/classify_trajectory_state/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>clean_trajectory</name>\n      <description>Use this skill when the user wants to clean raw GPS, check-in, signaling, taxi, or user mobility trajectory files by validating coordinates and timestamps, removing duplicates, filtering abnormal speed jumps, and exporting standardized cleaned trajectory points.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/clean_trajectory/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_flow_anomaly</name>\n      <description>Use this skill when the user wants to detect macro-level mobility flow anomalies, including abnormal region heat, check-in spikes, OD flow spikes, sudden decreases, or unusual time-window activity.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_flow_anomaly/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_route_anomaly</name>\n      <description>Use this skill when the user wants to detect individual trip or route anomalies, such as unusually long distance, unusually long/short duration, abnormal average speed, detours, or trips that deviate from a user's usual behavior.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_route_anomaly/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_trajectory_cooccurrence</name>\n      <description>Use this skill when the user asks to detect co-occurrence, companion trajectories, contact tracing, crowd gathering, group convergence, or multiple users appearing in the same space-time window.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_trajectory_cooccurrence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>extract_stay_points</name>\n      <description>Use this skill when the user wants to extract stay points, dwell events, OD endpoints, or meaningful stops from GPS, check-in, signaling, taxi, or cleaned trajectory data.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/extract_stay_points/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>forecast_region_flow</name>\n      <description>Use this skill when the user wants to predict future people or vehicle flow for target regions, based on historical regional activity series or raw trajectory points.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/forecast_region_flow/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>fuse_spatial_evidence</name>\n      <description>Use this skill when the user wants to combine hotspot, anomaly, profile, forecast, and event-impact outputs into a unified ranked regional evidence view.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/fuse_spatial_evidence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>map_spatial_grid</name>\n      <description>Use this skill when the user wants to map latitude/longitude trajectory records, staypoints, trips, or check-ins into spatial grids such as Geohash for aggregation and downstream spatial analysis.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/map_spatial_grid/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>measure_spatiotemporal_entropy</name>\n      <description>Use this skill when the user asks to measure spatiotemporal entropy, mobility diversity, regional vitality, flow complexity, inflow-outflow variety, or urban activity index.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/measure_spatiotemporal_entropy/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>mine_trajectory_patterns</name>\n      <description>Use this skill when the user asks to discover frequent travel patterns, recurring commuting sequences, repeated geohash chains, or multi-stop trip patterns from staypoints.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/mine_trajectory_patterns/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>predict_next_location</name>\n      <description>Use this skill when the user asks to predict next location, next stop, future geohash, likely destination, destination inference, or Markov-chain mobility prediction from historical trajectories.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/predict_next_location/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>profile_urban_region</name>\n      <description>Use this skill when the user wants to identify urban functional regions such as residential, commercial, transit, leisure, or mixed-use areas by combining trajectory activity and POI evidence.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/profile_urban_region/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>search_similar_trajectory</name>\n      <description>Use this skill when the user wants to find historical trips or trajectory records similar to a target trip based on start/end position, travel distance, and duration.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/search_similar_trajectory/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>search_spatiotemporal</name>\n      <description>Use this skill when the user wants to search or recall trajectory records by time window, hour range, geohash prefix, bounding box, city, or semantic text condition.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/search_spatiotemporal/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"6f911434-ffaf-40af-8a13-2d6f58fce238"}],"viewed_images":{},"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/31d491b6-22cb-4931-891a-e72834780703/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/31d491b6-22cb-4931-891a-e72834780703/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/31d491b6-22cb-4931-891a-e72834780703/user-data/outputs"},"raw_messages":[{"content":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"20c546fa-8619-4965-a935-102979858604"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_event_impact</name>\n      <description>Use this skill when the user wants to evaluate the impact of an external event such as rainstorm, sports event, traffic control, holiday, emergency, or policy intervention on regional trajectory volume.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_event_impact/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_od_flow</name>\n      <description>Use this skill when the user asks for OD flow analysis, origin-destination matrices, commute corridors, migration routes, or region-to-region movement aggregation from staypoints.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_od_flow/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_region_heat</name>\n      <description>Use this skill when the user wants to compute regional activity heat, check-in volume, point density, unique users, or Top-K active geohash regions from trajectory records.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_region_heat/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_spatiotemporal_accessibility</name>\n      <description>Use this skill when the user asks to compute trajectory-based isochrones, reachable areas, travel-time accessibility, radiation range, or real mobility coverage from a starting geohash.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_spatiotemporal_accessibility/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>anonymize_trajectory_data</name>\n      <description>Use this skill when the user asks to anonymize, desensitize, privacy-protect, differentially perturb, k-anonymize, hash user IDs, grid-generalize, or prepare sensitive GPS/check-in trajectory data before retrieval or LLM analysis.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/anonymize_trajectory_data/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>classify_trajectory_state</name>\n      <description>Use this skill when the user wants to classify each user's trajectory into motion states such as stationary, directed migration, frequent circulation, random walk, cruising, long-stay, or semantic mobility behavior.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/classify_trajectory_state/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>clean_trajectory</name>\n      <description>Use this skill when the user wants to clean raw GPS, check-in, signaling, taxi, or user mobility trajectory files by validating coordinates and timestamps, removing duplicates, filtering abnormal speed jumps, and exporting standardized cleaned trajectory points.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/clean_trajectory/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_flow_anomaly</name>\n      <description>Use this skill when the user wants to detect macro-level mobility flow anomalies, including abnormal region heat, check-in spikes, OD flow spikes, sudden decreases, or unusual time-window activity.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_flow_anomaly/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_route_anomaly</name>\n      <description>Use this skill when the user wants to detect individual trip or route anomalies, such as unusually long distance, unusually long/short duration, abnormal average speed, detours, or trips that deviate from a user's usual behavior.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_route_anomaly/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_trajectory_cooccurrence</name>\n      <description>Use this skill when the user asks to detect co-occurrence, companion trajectories, contact tracing, crowd gathering, group convergence, or multiple users appearing in the same space-time window.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_trajectory_cooccurrence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>extract_stay_points</name>\n      <description>Use this skill when the user wants to extract stay points, dwell events, OD endpoints, or meaningful stops from GPS, check-in, signaling, taxi, or cleaned trajectory data.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/extract_stay_points/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>forecast_region_flow</name>\n      <description>Use this skill when the user wants to predict future people or vehicle flow for target regions, based on historical regional activity series or raw trajectory points.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/forecast_region_flow/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>fuse_spatial_evidence</name>\n      <description>Use this skill when the user wants to combine hotspot, anomaly, profile, forecast, and event-impact outputs into a unified ranked regional evidence view.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/fuse_spatial_evidence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>map_spatial_grid</name>\n      <description>Use this skill when the user wants to map latitude/longitude trajectory records, staypoints, trips, or check-ins into spatial grids such as Geohash for aggregation and downstream spatial analysis.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/map_spatial_grid/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>measure_spatiotemporal_entropy</name>\n      <description>Use this skill when the user asks to measure spatiotemporal entropy, mobility diversity, regional vitality, flow complexity, inflow-outflow variety, or urban activity index.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/measure_spatiotemporal_entropy/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>mine_trajectory_patterns</name>\n      <description>Use this skill when the user asks to discover frequent travel patterns, recurring commuting sequences, repeated geohash chains, or multi-stop trip patterns from staypoints.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/mine_trajectory_patterns/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>predict_next_location</name>\n      <description>Use this skill when the user asks to predict next location, next stop, future geohash, likely destination, destination inference, or Markov-chain mobility prediction from historical trajectories.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/predict_next_location/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>profile_urban_region</name>\n      <description>Use this skill when the user wants to identify urban functional regions such as residential, commercial, transit, leisure, or mixed-use areas by combining trajectory activity and POI evidence.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/profile_urban_region/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>search_similar_trajectory</name>\n      <description>Use this skill when the user wants to find historical trips or trajectory records similar to a target trip based on start/end position, travel distance, and duration.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/search_similar_trajectory/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>search_spatiotemporal</name>\n      <description>Use this skill when the user wants to search or recall trajectory records by time window, hour range, geohash prefix, bounding box, city, or semantic text condition.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/search_spatiotemporal/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"6f911434-ffaf-40af-8a13-2d6f58fce238"}],"artifacts":[],"intent_context":{"intent":"task","original_query":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","normalized_query":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","routing_query":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","scene":"spatiotemporal_trajectory","scene_name":"时空轨迹","params":{},"scene_mode":"multi","scenes":["spatiotemporal_trajectory","video_surveillance"],"task_spans":[{"task_span_id":"span_ebb3c3","text":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。"}],"planning_steps":[{"task_span_id":"span_15c5ba","text":"针对视频监控场景，加载视频输入源并执行逐帧车辆目标检测与ID初始化，记录车辆首次出现的时间戳与像素坐标，输出结构化车辆初筛列表。"},{"task_span_id":"span_d0a9f2","text":"基于多目标关联追踪能力，提取每辆车的时序边界框序列，计算其在画面坐标系下的离散空间位置点集，输出带时间戳的原始追踪数据流。"},{"task_span_id":"span_a3af6e","text":"依托时空轨迹分析能力，运用坐标平滑算法拟合连续运动曲线，结合监控区域虚拟边界判定跨越进出口的临界帧，输出包含完整路径坐标的轨迹数据集。"},{"task_span_id":"span_b4c670","text":"依据轨迹起始终止坐标映射物理出入口以精确标定进入与离开时间，通过计算轨迹主方向向量推断行驶方向，输出携带动态属性的车辆明细表。"},{"task_span_id":"span_056cc8","text":"将时空轨迹数据与出入场时间及行驶方向进行跨场景逻辑校验，过滤轨迹断裂或ID跳变异常样本，按标准字段整合为可回溯的结构化跟踪台账。"}],"scene_tasks":[{"sub_task_id":"sub_b2cbc0","scene":"spatiotemporal_trajectory","scene_name":"时空轨迹","text":"生成画面中每辆车的运动轨迹。","params":{"分析对象":"画面中的每辆车","时间范围":"持续跟踪期间","空间范围":"画面覆盖区域"}},{"sub_task_id":"sub_491c03","scene":"video_surveillance","scene_name":"视频监控","text":"持续跟踪画面中的每辆车，生成它们的进入时间、离开时间和行驶方向。","params":{"视频对象":"画面","监控目标":"车辆的进入时间、离开时间、行驶方向"}}],"sub_tasks":[{"sub_task_id":"sub_b2cbc0","scene":"spatiotemporal_trajectory","scene_name":"时空轨迹","text":"生成画面中每辆车的运动轨迹。","params":{"分析对象":"画面中的每辆车","时间范围":"持续跟踪期间","空间范围":"画面覆盖区域"}},{"sub_task_id":"sub_491c03","scene":"video_surveillance","scene_name":"视频监控","text":"持续跟踪画面中的每辆车，生成它们的进入时间、离开时间和行驶方向。","params":{"视频对象":"画面","监控目标":"车辆的进入时间、离开时间、行驶方向"}}],"task_hints":[],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:20c546fa-8619-4965-a935-102979858604"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","scene":"spatiotemporal_trajectory","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"analyze_event_impact","role":"supporting","score":1.0,"reason":null},{"id":"analyze_od_flow","role":"supporting","score":1.0,"reason":null},{"id":"analyze_region_heat","role":"supporting","score":1.0,"reason":null},{"id":"analyze_spatiotemporal_accessibility","role":"supporting","score":1.0,"reason":null},{"id":"anonymize_trajectory_data","role":"supporting","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"classify_trajectory_state","role":"supporting","score":1.0,"reason":null},{"id":"clean_trajectory","role":"supporting","score":1.0,"reason":null},{"id":"detect_flow_anomaly","role":"supporting","score":1.0,"reason":null},{"id":"detect_route_anomaly","role":"supporting","score":1.0,"reason":null},{"id":"detect_trajectory_cooccurrence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"extract_stay_points","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"forecast_region_flow","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"fuse_spatial_evidence","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"map_spatial_grid","role":"supporting","score":1.0,"reason":null},{"id":"measure_spatiotemporal_entropy","role":"supporting","score":1.0,"reason":null},{"id":"mine_trajectory_patterns","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"predict_next_location","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"profile_urban_region","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"search_similar_trajectory","role":"supporting","score":1.0,"reason":null},{"id":"search_spatiotemporal","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:20c546fa-8619-4965-a935-102979858604"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"allowed_tool_names":[]}

event: values
data: {"messages":[{"content":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"20c546fa-8619-4965-a935-102979858604"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_event_impact</name>\n      <description>Use this skill when the user wants to evaluate the impact of an external event such as rainstorm, sports event, traffic control, holiday, emergency, or policy intervention on regional trajectory volume.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_event_impact/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_od_flow</name>\n      <description>Use this skill when the user asks for OD flow analysis, origin-destination matrices, commute corridors, migration routes, or region-to-region movement aggregation from staypoints.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_od_flow/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_region_heat</name>\n      <description>Use this skill when the user wants to compute regional activity heat, check-in volume, point density, unique users, or Top-K active geohash regions from trajectory records.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_region_heat/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_spatiotemporal_accessibility</name>\n      <description>Use this skill when the user asks to compute trajectory-based isochrones, reachable areas, travel-time accessibility, radiation range, or real mobility coverage from a starting geohash.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_spatiotemporal_accessibility/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>anonymize_trajectory_data</name>\n      <description>Use this skill when the user asks to anonymize, desensitize, privacy-protect, differentially perturb, k-anonymize, hash user IDs, grid-generalize, or prepare sensitive GPS/check-in trajectory data before retrieval or LLM analysis.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/anonymize_trajectory_data/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>classify_trajectory_state</name>\n      <description>Use this skill when the user wants to classify each user's trajectory into motion states such as stationary, directed migration, frequent circulation, random walk, cruising, long-stay, or semantic mobility behavior.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/classify_trajectory_state/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>clean_trajectory</name>\n      <description>Use this skill when the user wants to clean raw GPS, check-in, signaling, taxi, or user mobility trajectory files by validating coordinates and timestamps, removing duplicates, filtering abnormal speed jumps, and exporting standardized cleaned trajectory points.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/clean_trajectory/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_flow_anomaly</name>\n      <description>Use this skill when the user wants to detect macro-level mobility flow anomalies, including abnormal region heat, check-in spikes, OD flow spikes, sudden decreases, or unusual time-window activity.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_flow_anomaly/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_route_anomaly</name>\n      <description>Use this skill when the user wants to detect individual trip or route anomalies, such as unusually long distance, unusually long/short duration, abnormal average speed, detours, or trips that deviate from a user's usual behavior.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_route_anomaly/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_trajectory_cooccurrence</name>\n      <description>Use this skill when the user asks to detect co-occurrence, companion trajectories, contact tracing, crowd gathering, group convergence, or multiple users appearing in the same space-time window.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_trajectory_cooccurrence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>extract_stay_points</name>\n      <description>Use this skill when the user wants to extract stay points, dwell events, OD endpoints, or meaningful stops from GPS, check-in, signaling, taxi, or cleaned trajectory data.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/extract_stay_points/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>forecast_region_flow</name>\n      <description>Use this skill when the user wants to predict future people or vehicle flow for target regions, based on historical regional activity series or raw trajectory points.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/forecast_region_flow/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>fuse_spatial_evidence</name>\n      <description>Use this skill when the user wants to combine hotspot, anomaly, profile, forecast, and event-impact outputs into a unified ranked regional evidence view.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/fuse_spatial_evidence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>map_spatial_grid</name>\n      <description>Use this skill when the user wants to map latitude/longitude trajectory records, staypoints, trips, or check-ins into spatial grids such as Geohash for aggregation and downstream spatial analysis.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/map_spatial_grid/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>measure_spatiotemporal_entropy</name>\n      <description>Use this skill when the user asks to measure spatiotemporal entropy, mobility diversity, regional vitality, flow complexity, inflow-outflow variety, or urban activity index.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/measure_spatiotemporal_entropy/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>mine_trajectory_patterns</name>\n      <description>Use this skill when the user asks to discover frequent travel patterns, recurring commuting sequences, repeated geohash chains, or multi-stop trip patterns from staypoints.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/mine_trajectory_patterns/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>predict_next_location</name>\n      <description>Use this skill when the user asks to predict next location, next stop, future geohash, likely destination, destination inference, or Markov-chain mobility prediction from historical trajectories.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/predict_next_location/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>profile_urban_region</name>\n      <description>Use this skill when the user wants to identify urban functional regions such as residential, commercial, transit, leisure, or mixed-use areas by combining trajectory activity and POI evidence.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/profile_urban_region/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>search_similar_trajectory</name>\n      <description>Use this skill when the user wants to find historical trips or trajectory records similar to a target trip based on start/end position, travel distance, and duration.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/search_similar_trajectory/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>search_spatiotemporal</name>\n      <description>Use this skill when the user wants to search or recall trajectory records by time window, hour range, geohash prefix, bounding box, city, or semantic text condition.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/search_spatiotemporal/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"6f911434-ffaf-40af-8a13-2d6f58fce238"},{"content":"<system_reminder>\nUse the following current-turn intent and routing guidance when deciding whether to create or update todos. Treat it as planning context, not as a user request.\n<hidden_step source=\"intent_recognition\" title=\"意图识别\">\n改写后的任务：请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。\n识别场景：时空轨迹 (spatiotemporal_trajectory)；场景模式：multi；候选场景：spatiotemporal_trajectory, video_surveillance\n任务切分：\n- 请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。\n任务规划：\n1. 针对视频监控场景，加载视频输入源并执行逐帧车辆目标检测与ID初始化，记录车辆首次出现的时间戳与像素坐标，输出结构化车辆初筛列表。\n2. 基于多目标关联追踪能力，提取每辆车的时序边界框序列，计算其在画面坐标系下的离散空间位置点集，输出带时间戳的原始追踪数据流。\n3. 依托时空轨迹分析能力，运用坐标平滑算法拟合连续运动曲线，结合监控区域虚拟边界判定跨越进出口的临界帧，输出包含完整路径坐标的轨迹数据集。\n4. 依据轨迹起始终止坐标映射物理出入口以精确标定进入与离开时间，通过计算轨迹主方向向量推断行驶方向，输出携带动态属性的车辆明细表。\n5. 将时空轨迹数据与出入场时间及行驶方向进行跨场景逻辑校验，过滤轨迹断裂或ID跳变异常样本，按标准字段整合为可回溯的结构化跟踪台账。\n场景任务：\n- spatiotemporal_trajectory: 生成画面中每辆车的运动轨迹。；参数：{'分析对象': '画面中的每辆车', '时间范围': '持续跟踪期间', '空间范围': '画面覆盖区域'}\n- video_surveillance: 持续跟踪画面中的每辆车，生成它们的进入时间、离开时间和行驶方向。；参数：{'视频对象': '画面', '监控目标': '车辆的进入时间、离开时间、行驶方向'}\n</hidden_step>\n</system_reminder>","additional_kwargs":{},"response_metadata":{},"type":"human","name":"todo_routing_guidance","id":"cda51a1a-0f98-41c8-9050-d1a66795623f"}],"viewed_images":{},"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/31d491b6-22cb-4931-891a-e72834780703/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/31d491b6-22cb-4931-891a-e72834780703/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/31d491b6-22cb-4931-891a-e72834780703/user-data/outputs"},"raw_messages":[{"content":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"20c546fa-8619-4965-a935-102979858604"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_event_impact</name>\n      <description>Use this skill when the user wants to evaluate the impact of an external event such as rainstorm, sports event, traffic control, holiday, emergency, or policy intervention on regional trajectory volume.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_event_impact/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_od_flow</name>\n      <description>Use this skill when the user asks for OD flow analysis, origin-destination matrices, commute corridors, migration routes, or region-to-region movement aggregation from staypoints.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_od_flow/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_region_heat</name>\n      <description>Use this skill when the user wants to compute regional activity heat, check-in volume, point density, unique users, or Top-K active geohash regions from trajectory records.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_region_heat/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>analyze_spatiotemporal_accessibility</name>\n      <description>Use this skill when the user asks to compute trajectory-based isochrones, reachable areas, travel-time accessibility, radiation range, or real mobility coverage from a starting geohash.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/analyze_spatiotemporal_accessibility/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>anonymize_trajectory_data</name>\n      <description>Use this skill when the user asks to anonymize, desensitize, privacy-protect, differentially perturb, k-anonymize, hash user IDs, grid-generalize, or prepare sensitive GPS/check-in trajectory data before retrieval or LLM analysis.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/anonymize_trajectory_data/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>classify_trajectory_state</name>\n      <description>Use this skill when the user wants to classify each user's trajectory into motion states such as stationary, directed migration, frequent circulation, random walk, cruising, long-stay, or semantic mobility behavior.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/classify_trajectory_state/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>clean_trajectory</name>\n      <description>Use this skill when the user wants to clean raw GPS, check-in, signaling, taxi, or user mobility trajectory files by validating coordinates and timestamps, removing duplicates, filtering abnormal speed jumps, and exporting standardized cleaned trajectory points.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/clean_trajectory/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_flow_anomaly</name>\n      <description>Use this skill when the user wants to detect macro-level mobility flow anomalies, including abnormal region heat, check-in spikes, OD flow spikes, sudden decreases, or unusual time-window activity.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_flow_anomaly/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_route_anomaly</name>\n      <description>Use this skill when the user wants to detect individual trip or route anomalies, such as unusually long distance, unusually long/short duration, abnormal average speed, detours, or trips that deviate from a user's usual behavior.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_route_anomaly/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>detect_trajectory_cooccurrence</name>\n      <description>Use this skill when the user asks to detect co-occurrence, companion trajectories, contact tracing, crowd gathering, group convergence, or multiple users appearing in the same space-time window.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/detect_trajectory_cooccurrence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>extract_stay_points</name>\n      <description>Use this skill when the user wants to extract stay points, dwell events, OD endpoints, or meaningful stops from GPS, check-in, signaling, taxi, or cleaned trajectory data.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/extract_stay_points/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>forecast_region_flow</name>\n      <description>Use this skill when the user wants to predict future people or vehicle flow for target regions, based on historical regional activity series or raw trajectory points.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/forecast_region_flow/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>fuse_spatial_evidence</name>\n      <description>Use this skill when the user wants to combine hotspot, anomaly, profile, forecast, and event-impact outputs into a unified ranked regional evidence view.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/fuse_spatial_evidence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>map_spatial_grid</name>\n      <description>Use this skill when the user wants to map latitude/longitude trajectory records, staypoints, trips, or check-ins into spatial grids such as Geohash for aggregation and downstream spatial analysis.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/map_spatial_grid/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>measure_spatiotemporal_entropy</name>\n      <description>Use this skill when the user asks to measure spatiotemporal entropy, mobility diversity, regional vitality, flow complexity, inflow-outflow variety, or urban activity index.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/measure_spatiotemporal_entropy/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>mine_trajectory_patterns</name>\n      <description>Use this skill when the user asks to discover frequent travel patterns, recurring commuting sequences, repeated geohash chains, or multi-stop trip patterns from staypoints.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/mine_trajectory_patterns/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>predict_next_location</name>\n      <description>Use this skill when the user asks to predict next location, next stop, future geohash, likely destination, destination inference, or Markov-chain mobility prediction from historical trajectories.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/predict_next_location/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>profile_urban_region</name>\n      <description>Use this skill when the user wants to identify urban functional regions such as residential, commercial, transit, leisure, or mixed-use areas by combining trajectory activity and POI evidence.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/profile_urban_region/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>search_similar_trajectory</name>\n      <description>Use this skill when the user wants to find historical trips or trajectory records similar to a target trip based on start/end position, travel distance, and duration.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/search_similar_trajectory/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>search_spatiotemporal</name>\n      <description>Use this skill when the user wants to search or recall trajectory records by time window, hour range, geohash prefix, bounding box, city, or semantic text condition.</description>\n      <location>/mnt/skills/custom/spatiotemporal_trajectory/search_spatiotemporal/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"6f911434-ffaf-40af-8a13-2d6f58fce238"}],"artifacts":[],"intent_context":{"intent":"task","original_query":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","normalized_query":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","routing_query":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","scene":"spatiotemporal_trajectory","scene_name":"时空轨迹","params":{},"scene_mode":"multi","scenes":["spatiotemporal_trajectory","video_surveillance"],"task_spans":[{"task_span_id":"span_ebb3c3","text":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。"}],"planning_steps":[{"task_span_id":"span_15c5ba","text":"针对视频监控场景，加载视频输入源并执行逐帧车辆目标检测与ID初始化，记录车辆首次出现的时间戳与像素坐标，输出结构化车辆初筛列表。"},{"task_span_id":"span_d0a9f2","text":"基于多目标关联追踪能力，提取每辆车的时序边界框序列，计算其在画面坐标系下的离散空间位置点集，输出带时间戳的原始追踪数据流。"},{"task_span_id":"span_a3af6e","text":"依托时空轨迹分析能力，运用坐标平滑算法拟合连续运动曲线，结合监控区域虚拟边界判定跨越进出口的临界帧，输出包含完整路径坐标的轨迹数据集。"},{"task_span_id":"span_b4c670","text":"依据轨迹起始终止坐标映射物理出入口以精确标定进入与离开时间，通过计算轨迹主方向向量推断行驶方向，输出携带动态属性的车辆明细表。"},{"task_span_id":"span_056cc8","text":"将时空轨迹数据与出入场时间及行驶方向进行跨场景逻辑校验，过滤轨迹断裂或ID跳变异常样本，按标准字段整合为可回溯的结构化跟踪台账。"}],"scene_tasks":[{"sub_task_id":"sub_b2cbc0","scene":"spatiotemporal_trajectory","scene_name":"时空轨迹","text":"生成画面中每辆车的运动轨迹。","params":{"分析对象":"画面中的每辆车","时间范围":"持续跟踪期间","空间范围":"画面覆盖区域"}},{"sub_task_id":"sub_491c03","scene":"video_surveillance","scene_name":"视频监控","text":"持续跟踪画面中的每辆车，生成它们的进入时间、离开时间和行驶方向。","params":{"视频对象":"画面","监控目标":"车辆的进入时间、离开时间、行驶方向"}}],"sub_tasks":[{"sub_task_id":"sub_b2cbc0","scene":"spatiotemporal_trajectory","scene_name":"时空轨迹","text":"生成画面中每辆车的运动轨迹。","params":{"分析对象":"画面中的每辆车","时间范围":"持续跟踪期间","空间范围":"画面覆盖区域"}},{"sub_task_id":"sub_491c03","scene":"video_surveillance","scene_name":"视频监控","text":"持续跟踪画面中的每辆车，生成它们的进入时间、离开时间和行驶方向。","params":{"视频对象":"画面","监控目标":"车辆的进入时间、离开时间、行驶方向"}}],"task_hints":[],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:20c546fa-8619-4965-a935-102979858604"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"请持续跟踪画面中的每辆车，生成它们的进入时间、离开时间、运动轨迹和行驶方向。","scene":"spatiotemporal_trajectory","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"analyze_event_impact","role":"supporting","score":1.0,"reason":null},{"id":"analyze_od_flow","role":"supporting","score":1.0,"reason":null},{"id":"analyze_region_heat","role":"supporting","score":1.0,"reason":null},{"id":"analyze_spatiotemporal_accessibility","role":"supporting","score":1.0,"reason":null},{"id":"anonymize_trajectory_data","role":"supporting","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"classify_trajectory_state","role":"supporting","score":1.0,"reason":null},{"id":"clean_trajectory","role":"supporting","score":1.0,"reason":null},{"id":"detect_flow_anomaly","role":"supporting","score":1.0,"reason":null},{"id":"detect_route_anomaly","role":"supporting","score":1.0,"reason":null},{"id":"detect_trajectory_cooccurrence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"extract_stay_points","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"forecast_region_flow","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"fuse_spatial_evidence","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"map_spatial_grid","role":"supporting","score":1.0,"reason":null},{"id":"measure_spatiotemporal_entropy","role":"supporting","score":1.0,"reason":null},{"id":"mine_trajectory_patterns","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"predict_next_location","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"profile_urban_region","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"search_similar_trajectory","role":"supporting","score":1.0,"reason":null},{"id":"search_spatiotemporal","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:20c546fa-8619-4965-a935-102979858604"},"dialogue_context":{"act":"new_task"