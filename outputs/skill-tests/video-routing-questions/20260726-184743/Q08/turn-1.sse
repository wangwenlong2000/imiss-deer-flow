,"role":"supporting","score":1.0,"reason":null},{"id":"search_spatiotemporal","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:0c5caec3-7c0b-4914-97ad-4542c2de42b7"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","batch-video-ingestion","camera-health-check","city-video-intelligence","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","extract_stay_points","ffmpeg-utils","forecast_region_flow","frame-sampling","fuse_spatial_evidence","human-review-routing","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","object-detection","object-statistics","object-tracking","predict_next_location","privacy-masking","profile_urban_region","roi-mapping","search_similar_trajectory","search_spatiotemporal","single-video-event-analysis","video-embedding-index","video-object-analytics","vid