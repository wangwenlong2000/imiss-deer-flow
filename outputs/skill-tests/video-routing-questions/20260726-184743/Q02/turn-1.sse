data: {"messages":[{"content":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"cfced2ba-2fdb-4358-a300-299c7be0dcc7"}],"viewed_images":{},"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/outputs"},"raw_messages":[],"artifacts":[],"intent_context":{"intent":"task","original_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","normalized_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_81ce82","text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。"}],"planning_steps":[{"task_span_id":"span_55a934","text":"读取该批次摄像头的设备台账与近期视频流接入记录，利用监控资源管理接口获取各设备的基础参数与运行日志，完成数据清洗与待检样本结构化入库。"},{"task_span_id":"span_81f36f","text":"调用视频监控场景的图像质量诊断模型与流媒体监测模块，针对采样视频帧计算平均亮度与像素饱和度以识别黑屏和过曝，通过梯度幅值与信噪比指标定位模糊与花屏，同时依据RTP/RTSP丢包率与连接状态判定断流情况。"},{"task_span_id":"span_7e07c8","text":"提取视频帧头及系统日志中的时间戳字段，参照平台标准时钟源进行差分计算，以毫秒级偏差阈值为依据筛查时间戳漂移或不同步设备，并将上述视听觉异常结果按设备标识进行聚合对齐。"},{"task_span_id":"span_3a24d1","text":"整合多模态检测结果生成结构化异常排查报告，按故障类别统计受影响设备数量与发生频率，输出明确标注设备ID、异常类型、发现时间及关联证据链的交付清单，支撑后续巡检与维护决策。"}],"scene_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"sub_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}}}

event: values
data: {"messages":[{"content":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"cfced2ba-2fdb-4358-a300-299c7be0dcc7"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"275cddb4-bce1-4145-acfc-f05b67bc9de3"}],"viewed_images":{},"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/outputs"},"raw_messages":[],"artifacts":[],"intent_context":{"intent":"task","original_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","normalized_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_81ce82","text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。"}],"planning_steps":[{"task_span_id":"span_55a934","text":"读取该批次摄像头的设备台账与近期视频流接入记录，利用监控资源管理接口获取各设备的基础参数与运行日志，完成数据清洗与待检样本结构化入库。"},{"task_span_id":"span_81f36f","text":"调用视频监控场景的图像质量诊断模型与流媒体监测模块，针对采样视频帧计算平均亮度与像素饱和度以识别黑屏和过曝，通过梯度幅值与信噪比指标定位模糊与花屏，同时依据RTP/RTSP丢包率与连接状态判定断流情况。"},{"task_span_id":"span_7e07c8","text":"提取视频帧头及系统日志中的时间戳字段，参照平台标准时钟源进行差分计算，以毫秒级偏差阈值为依据筛查时间戳漂移或不同步设备，并将上述视听觉异常结果按设备标识进行聚合对齐。"},{"task_span_id":"span_3a24d1","text":"整合多模态检测结果生成结构化异常排查报告，按故障类别统计受影响设备数量与发生频率，输出明确标注设备ID、异常类型、发现时间及关联证据链的交付清单，支撑后续巡检与维护决策。"}],"scene_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"sub_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"allowed_tool_names":[]}

event: values
data: {"messages":[{"content":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"cfced2ba-2fdb-4358-a300-299c7be0dcc7"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"275cddb4-bce1-4145-acfc-f05b67bc9de3"}],"viewed_images":{},"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/outputs"},"raw_messages":[{"content":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"cfced2ba-2fdb-4358-a300-299c7be0dcc7"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"275cddb4-bce1-4145-acfc-f05b67bc9de3"}],"artifacts":[],"intent_context":{"intent":"task","original_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","normalized_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_81ce82","text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。"}],"planning_steps":[{"task_span_id":"span_55a934","text":"读取该批次摄像头的设备台账与近期视频流接入记录，利用监控资源管理接口获取各设备的基础参数与运行日志，完成数据清洗与待检样本结构化入库。"},{"task_span_id":"span_81f36f","text":"调用视频监控场景的图像质量诊断模型与流媒体监测模块，针对采样视频帧计算平均亮度与像素饱和度以识别黑屏和过曝，通过梯度幅值与信噪比指标定位模糊与花屏，同时依据RTP/RTSP丢包率与连接状态判定断流情况。"},{"task_span_id":"span_7e07c8","text":"提取视频帧头及系统日志中的时间戳字段，参照平台标准时钟源进行差分计算，以毫秒级偏差阈值为依据筛查时间戳漂移或不同步设备，并将上述视听觉异常结果按设备标识进行聚合对齐。"},{"task_span_id":"span_3a24d1","text":"整合多模态检测结果生成结构化异常排查报告，按故障类别统计受影响设备数量与发生频率，输出明确标注设备ID、异常类型、发现时间及关联证据链的交付清单，支撑后续巡检与维护决策。"}],"scene_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"sub_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"allowed_tool_names":[]}

event: values
data: {"messages":[{"content":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"cfced2ba-2fdb-4358-a300-299c7be0dcc7"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"275cddb4-bce1-4145-acfc-f05b67bc9de3"},{"content":"<system_reminder>\nUse the following current-turn intent and routing guidance when deciding whether to create or update todos. Treat it as planning context, not as a user request.\n<hidden_step source=\"intent_recognition\" title=\"意图识别\">\n改写后的任务：场景：视频监控。场景ID：video_surveillance\n识别场景：视频监控 (video_surveillance)；场景模式：single；候选场景：video_surveillance\n任务切分：\n- 请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。\n任务规划：\n1. 读取该批次摄像头的设备台账与近期视频流接入记录，利用监控资源管理接口获取各设备的基础参数与运行日志，完成数据清洗与待检样本结构化入库。\n2. 调用视频监控场景的图像质量诊断模型与流媒体监测模块，针对采样视频帧计算平均亮度与像素饱和度以识别黑屏和过曝，通过梯度幅值与信噪比指标定位模糊与花屏，同时依据RTP/RTSP丢包率与连接状态判定断流情况。\n3. 提取视频帧头及系统日志中的时间戳字段，参照平台标准时钟源进行差分计算，以毫秒级偏差阈值为依据筛查时间戳漂移或不同步设备，并将上述视听觉异常结果按设备标识进行聚合对齐。\n4. 整合多模态检测结果生成结构化异常排查报告，按故障类别统计受影响设备数量与发生频率，输出明确标注设备ID、异常类型、发现时间及关联证据链的交付清单，支撑后续巡检与维护决策。\n场景任务：\n- video_surveillance: 我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。；参数：{'视频对象': '这批摄像头', '监控目标': '黑屏、花屏、模糊、过曝、断流、时间戳异常', '时间范围': '最近'}\n已提取参数：{'视频对象': '这批摄像头', '监控目标': '黑屏、花屏、模糊、过曝、断流、时间戳异常', '时间范围': '最近'}\n任务提示：\n- 提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧\n- 提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等\n- 提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口\n- 提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要\n</hidden_step>\n</system_reminder>","additional_kwargs":{},"response_metadata":{},"type":"human","name":"todo_routing_guidance","id":"4dd319eb-8f4a-4f71-a6d5-91f4e2a18510"}],"viewed_images":{},"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/0028ebd7-3586-4cdc-b66d-1d5d8c0a31d7/user-data/outputs"},"raw_messages":[{"content":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","additional_kwargs":{},"response_metadata":{},"type":"human","name":null,"id":"cfced2ba-2fdb-4358-a300-299c7be0dcc7"},{"content":"<skill_system source=\"skill_router\">\nYou have access to skills that provide optimized workflows for specific tasks. Each skill contains best practices, frameworks, and references to additional resources.\n\n**Skill Availability Rules:**\n- Public skills listed in the base system prompt are available across turns.\n- Custom/domain skills are available only when listed in a current-turn routed <available_skills> section.\n- Ignore custom/domain skills mentioned in previous turns if they are not listed in the current turn.\n- Do not call tools associated with unavailable skills.\n- If a later current-turn routed_skill_prompt is injected by SkillRouter, its <available_skills> list recommends the custom/domain skills for this turn; public skills from the base prompt remain available as supporting workflows.\n- When SkillRouter ranking is disabled and scene filtering injects all skills for a scene, treat <available_skills> as an allowed candidate set. Select the specific skill or skills that match the current user request before loading skill files or executing workflows.\n\n**Override Scope:**\n- This routed <skill_system> lists recommended custom/domain skills for the current turn.\n- It does NOT replace the base system prompt.\n- Public skills listed in the base system prompt remain available for supporting operations.\n- When uploaded structured files (Excel, CSV, JSON, Parquet, or similar tabular evidence) are central to the user's request, use the public data-analysis skill first to inspect and extract facts before domain synthesis.\n- Continue following language_policy, clarification_system, working_directory, response_style, and critical_reminders from the base system prompt.\n\n**Progressive Loading Pattern:**\n1. When a user query matches an available skill's use case, first choose the concrete skill.\n2. Call `invoke_skill` in `prepare` mode for that selected skill to create and validate the SkillInputEnvelope and legacy invocation package.\n3. Read the returned skill file path and understand the skill's workflow and instructions.\n4. The skill file contains references to external resources under the same folder.\n5. Load referenced resources only when needed during execution.\n6. Follow the skill's instructions precisely.\n7. After legacy execution, call `invoke_skill` in `wrap_output` mode to normalize the result into SkillResult when a machine-readable Skill output is needed.\n\n**Mandatory Skill Execution Discipline:**\n- Calling `invoke_skill` in `prepare` mode is NOT sufficient. It only prepares the selected Skill invocation. After `prepare`, you MUST actually execute the selected Skill workflow.\n- After `invoke_skill(mode=\"prepare\")` returns `legacy_invocation.container_skill_file`, you MUST read that Skill file and treat it as the authoritative execution guide.\n- If the Skill provides scripts, commands, templates, references, or executable workflows, you MUST use those Skill-provided assets first.\n- Do NOT replace a matched Skill workflow with ad hoc Python, pandas, SQL, shell, or manual analysis code before attempting the Skill workflow.\n- For `data-analysis`, if `/mnt/skills/public/data-analysis/scripts/analyze.py` is available and the task is structured data analysis, you MUST call that script first for data inspection, SQL query, aggregation, statistics, or chart preparation. Do not write standalone pandas code for the same operation before trying this script.\n- Custom code is allowed only after one of these conditions is true:\n  1. the selected Skill file does not provide a suitable executable workflow;\n  2. the Skill-provided script or workflow has been attempted and failed;\n  3. the user explicitly requests custom code;\n  4. the required operation is clearly outside the Skill's documented capability.\n- When you fall back to custom code, briefly state that the Skill workflow was insufficient or failed, and continue from the Skill result or error.\n\n**Skill Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n    <skill>\n      <name>analyze-video</name>\n      <description>专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。</description>\n      <location>/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>batch-video-ingestion</name>\n      <description>Batch ingest local monitoring videos into the Elasticsearch video library after city-video-intelligence has routed the request, with metadata, sampled-frame object summaries, and searchable documents. For direct user video ingestion, ingest-and-embed, Elasticsearch, StreetModel, or business video-library requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear ingestion plan, video directory, video manifest, camera_id, or multiple video files to index for later retrieval and statistics.</description>\n      <location>/mnt/skills/custom/video_surveillance/batch-video-ingestion/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>camera-health-check</name>\n      <description>Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.</description>\n      <location>/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>city-video-intelligence</name>\n      <description>Business orchestration for city video intelligence requests. Use when users ask for monitoring video search, semantic video retrieval, event review, object statistics, evidence packages, video ingestion, camera health operations, cross-camera analysis, or role-based scenarios such as traffic police, property security, urban management, emergency management, or legal evidence preparation. Also use it when the user asks what the current data and skills can or cannot support (capability-boundary questions) — it answers with an explicit capability_gap instead of guessing. This skill maps business intent to existing custom video skills and prevents ad hoc code generation unless the user explicitly asks for development or testing.</description>\n      <location>/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>duplicate-event-merge</name>\n      <description>Merge duplicate video event candidates from the same camera, event type, ROI, evidence frames, or overlapping time window. Use after single-video-event-analysis or batch video analysis when Codex has a list of Event Candidate records and needs canonical events plus duplicate mappings.</description>\n      <location>/mnt/skills/custom/video_surveillance/duplicate-event-merge/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-package-generation</name>\n      <description>Generate an evidence package manifest for indexed monitoring videos or event/search results, including snapshot evidence and optional short video clips. Use when Codex needs a package_id, manifest URI, evidence items, hashes, and reusable evidence artifacts.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-package-generation/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>evidence-snapshot</name>\n      <description>Generate snapshot evidence for video monitoring event candidates. Use when Codex has an event, event_id, evidence_frame_ids, image_uri, or frame list and needs a snapshot URI, SHA-256 integrity hash, created_at timestamp, privacy masking status, and Evidence schema output.</description>\n      <location>/mnt/skills/custom/video_surveillance/evidence-snapshot/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>ffmpeg-utils</name>\n      <description>视频处理工具集，支持视频截取和关键帧提取。常用于将监控视频剪辑为证据片段。</description>\n      <location>/mnt/skills/custom/video_surveillance/ffmpeg-utils/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>frame-sampling</name>\n      <description>Sample structured frames from an existing video file. Use when Codex has video_path, file_path, raw_segment_uri, camera_id, sampling_strategy, capture_seconds, or provided frame records and needs stable Frame schema outputs. This skill exposes OpenCV-backed real video frame extraction.</description>\n      <location>/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>human-review-routing</name>\n      <description>Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.</description>\n      <location>/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-detection</name>\n      <description>Detect visible objects in sampled video frames and return standard Detection schema only. Use when Codex needs YOLO labels, confidences, and bounding boxes for people, vehicles, or COCO objects. Do not use this skill to infer events, abnormal behavior, accidents, fights, falls, congestion, intrusion, smoke/fire, or business semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-detection/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-statistics</name>\n      <description>Compute object statistics for monitoring videos from Elasticsearch video-library records or local detections/tracks JSON. Use when Codex needs counts by label, camera, time bucket, or movement state.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-statistics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>object-tracking</name>\n      <description>Track detected objects across video frames and return Track schema for object analytics only. Use when Codex has frame-level detections and needs stable track ids, trajectories, duration, last bbox, movement state, confidence, and evidence frame ids. Do not use this skill to infer video events or abnormal behavior.</description>\n      <location>/mnt/skills/custom/video_surveillance/object-tracking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>privacy-masking</name>\n      <description>Mask sensitive visual data in video evidence such as faces, license plates, phone numbers, and doorplates. Use when Codex has an evidence image URI and explicit sensitive_regions bbox coordinates, or privacy_masking config and needs a masked URI before exposing snapshots or clips externally. This skill exposes OpenCV image read/write and Gaussian blur masking for real files.</description>\n      <location>/mnt/skills/custom/video_surveillance/privacy-masking/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>roi-mapping</name>\n      <description>Match detections or tracks against configured camera ROI polygons for geometric object analytics. Use when Codex has camera_id plus tracks or objects and needs point containment or bbox overlap matches for configured areas. Do not use this skill to decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/roi-mapping/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>single-video-event-analysis</name>\n      <description>Analyze one local monitoring video for incidents after city-video-intelligence has routed the request, by extracting timestamped frames and having the LLM review visible evidence. Use for fight, fall, traffic accident, congestion, crowd gathering, smoke/fire, intrusion, illegal occupation, or other abnormal events. For direct user monitoring-video event questions, load city-video-intelligence first. This skill is the only custom event-detection entrypoint; YOLO/object detection may be used only as optional object context and must not decide event semantics.</description>\n      <location>/mnt/skills/custom/video_surveillance/single-video-event-analysis/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-embedding-index</name>\n      <description>Generate text embeddings or StreetModel sampled-frame image embeddings for video-library documents after city-video-intelligence has routed the request. Only enrich citybrain-video-library in place. For direct user StreetModel, ingest-and-embed, semantic retrieval, benchmark, or keyword-vs-vector requests, load city-video-intelligence first.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-embedding-index/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-object-analytics</name>\n      <description>Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-search</name>\n      <description>Search indexed monitoring videos from text, images, structured filters, or precomputed vectors. Use for keyword retrieval, LLM-optimized text-to-video semantic retrieval, combined keyword/vector search, or image-to-video similarity search against StreetModel/Qwen3-VL video vectors.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-search/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-segment-extraction</name>\n      <description>Extract playable short video evidence clips around event times. Use when Codex has event_id, camera_id, raw_segment_uri, event_time, event_elapsed_seconds, pre_seconds, or post_seconds and needs an MP4 clip URI plus clip time range. This skill exposes FFmpeg-backed clipping for real local videos and memory-backed synthetic clips for tests.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-segment-extraction/SKILL.md</location>\n    </skill>\n    <skill>\n      <name>video-stream-ingestion</name>\n      <description>Normalize an existing local video file after city-video-intelligence has routed a video-library or analysis request, returning raw segment/session metadata such as duration, resolution, frame rate, codec, and session times. Use it for any \"read this video's duration / resolution / fps / codec / metadata\" or \"turn this video into a standard analysis input\" request instead of running ffprobe by hand. For direct user ingestion, Elasticsearch, StreetModel, search, statistics, evidence, or camera-health requests, load city-video-intelligence first. Use this atomic skill when Codex already has a clear plan and a local MP4/MOV/AVI/MKV file before frame sampling.</description>\n      <location>/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md</location>\n    </skill>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"275cddb4-bce1-4145-acfc-f05b67bc9de3"}],"artifacts":[],"intent_context":{"intent":"task","original_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","normalized_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_81ce82","text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。"}],"planning_steps":[{"task_span_id":"span_55a934","text":"读取该批次摄像头的设备台账与近期视频流接入记录，利用监控资源管理接口获取各设备的基础参数与运行日志，完成数据清洗与待检样本结构化入库。"},{"task_span_id":"span_81f36f","text":"调用视频监控场景的图像质量诊断模型与流媒体监测模块，针对采样视频帧计算平均亮度与像素饱和度以识别黑屏和过曝，通过梯度幅值与信噪比指标定位模糊与花屏，同时依据RTP/RTSP丢包率与连接状态判定断流情况。"},{"task_span_id":"span_7e07c8","text":"提取视频帧头及系统日志中的时间戳字段，参照平台标准时钟源进行差分计算，以毫秒级偏差阈值为依据筛查时间戳漂移或不同步设备，并将上述视听觉异常结果按设备标识进行聚合对齐。"},{"task_span_id":"span_3a24d1","text":"整合多模态检测结果生成结构化异常排查报告，按故障类别统计受影响设备数量与发生频率，输出明确标注设备ID、异常类型、发现时间及关联证据链的交付清单，支撑后续巡检与维护决策。"}],"scene_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"sub_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"allowed_tool_names":[]}

