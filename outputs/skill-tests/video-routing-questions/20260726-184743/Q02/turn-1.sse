摄像头', '监控目标': '黑屏、花屏、模糊、过曝、断流、时间戳异常', '时间范围': '最近'}\\n已提取参数：{'视频对象': '这批摄像头', '监控目标': '黑屏、花屏、模糊、过曝、断流、时间戳异常', '时间范围': '最近'}\\n任务提示：\\n- 提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧\\n- 提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等\\n- 提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口\\n- 提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要\\n</hidden_step>\\n</system_reminder>\"\n    },\n    \"inputs\": {\n      \"parameters\": {}\n    },\n    \"routing\": {\n      \"selected_skill\": \"city-video-intelligence\",\n      \"allowed_skills\": [\n        \"analyze-video\",\n        \"batch-video-ingestion\",\n        \"camera-health-check\",\n        \"city-video-intelligence\",\n        \"duplicate-event-merge\",\n        \"evidence-package-generation\",\n        \"evidence-snapshot\",\n        \"ffmpeg-utils\",\n        \"frame-sampling\",\n        \"human-review-routing\",\n        \"object-detection\",\n        \"object-statistics\",\n        \"object-tracking\",\n        \"privacy-masking\",\n        \"roi-mapping\",\n        \"single-video-event-analysis\",\n        \"video-embedding-index\",\n        \"video-object-analytics\",\n        \"video-search\",\n        \"video-segment-extraction\",\n        \"video-stream-ingestion\"\n      ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/city-video-intelligence\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/city-video-intelligence/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/city-video-intelligence\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"bec0076d-af20-4f66-a815-98211f7a08bf","tool_call_id":"call_c10a5b205d204effa101436b","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":165,"prompt_tokens":15756,"total_tokens":15921,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":46,"rejected_prediction_tokens":null,"text_tokens":165},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":15756}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-b6f3260f-08a0-964c-a255-f04f5aa7ae15","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e14-043e-7f71-9d32-743b5103d4a8-0","tool_calls":[{"name":"read_file","args":{"description":"读取视频监控智能编排技能说明","path":"/mnt/skills/custom/video_surveillance/city-video-intelligence/SKILL.md"},"id":"call_889b008bd39d400ebac5e9ac","type":"tool_call"},{"name":"read_file","args":{"description":"读取摄像头健康检查技能说明","path":"/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md"},"id":"call_f94242dee896431dbd6d70c8","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":15756,"output_tokens":165,"total_tokens":15921,"input_token_details":{},"output_token_details":{"reasoning":46}}}],"artifacts":[],"intent_context":{"intent":"task","original_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","normalized_query":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_81ce82","text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。"}],"planning_steps":[{"task_span_id":"span_55a934","text":"读取该批次摄像头的设备台账与近期视频流接入记录，利用监控资源管理接口获取各设备的基础参数与运行日志，完成数据清洗与待检样本结构化入库。"},{"task_span_id":"span_81f36f","text":"调用视频监控场景的图像质量诊断模型与流媒体监测模块，针对采样视频帧计算平均亮度与像素饱和度以识别黑屏和过曝，通过梯度幅值与信噪比指标定位模糊与花屏，同时依据RTP/RTSP丢包率与连接状态判定断流情况。"},{"task_span_id":"span_7e07c8","text":"提取视频帧头及系统日志中的时间戳字段，参照平台标准时钟源进行差分计算，以毫秒级偏差阈值为依据筛查时间戳漂移或不同步设备，并将上述视听觉异常结果按设备标识进行聚合对齐。"},{"task_span_id":"span_3a24d1","text":"整合多模态检测结果生成结构化异常排查报告，按故障类别统计受影响设备数量与发生频率，输出明确标注设备ID、异常类型、发现时间及关联证据链的交付清单，支撑后续巡检与维护决策。"}],"scene_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"sub_tasks":[{"sub_task_id":"sub_0da2ec","scene":"video_surveillance","scene_name":"视频监控","text":"我将检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","params":{"视频对象":"这批摄像头","监控目标":"黑屏、花屏、模糊、过曝、断流、时间戳异常","时间范围":"最近"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"请检查这批摄像头最近的视频质量，找出黑屏、花屏、模糊、过曝、断流和时间戳异常的设备。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:cfced2ba-2fdb-4358-a300-299c7be0dcc7"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"allowed_tool_names":[]}

