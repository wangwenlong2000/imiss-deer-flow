d `src`, `tools`, or registry modules.\n\n## Inputs\n\nRequired:\n- `camera_id`\n- `source_type`: `local_file`\n\nCommon fields:\n- `file_path`, `video_path`, or `raw_segment_uri`\n- `capture_seconds`\n- `started_at`\n\n## Outputs\n\nReturns `raw_segment_uri`, `video_session_id`, `started_at`, `ended_at`, `duration_seconds`, video width/height when available, and `file_status`.\n\n## Failure Modes\n\n- `MISSING_CAMERA_ID`\n- `UNSUPPORTED_SOURCE`\n- `SOURCE_NOT_FOUND`\n\n## Constraints\n\nDo not detect objects, sample frames, create events, or generate evidence.\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"4a139fc6-44e4-4d3c-9b3b-083765bf44b3","tool_call_id":"call_4a79997eb823499a8b5803f2","artifact":null,"status":"success"},{"content":"现在执行测试命令：\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":147,"prompt_tokens":9702,"total_tokens":9849,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":0,"rejected_prediction_tokens":null,"text_tokens":147},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":9702}},"model_provider":"openai","model_name":"qwen3.5-plus","system_fingerprint":null,"id":"chatcmpl-4a480491-54ef-95d5-a16e-3393400ee22d","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019e628e-3058-7e90-92da-66a7b1296b7f-0","tool_calls":[{"name":"bash","args":{"description":"执行 video-stream-ingestion skill 的测试命令","command":"mkdir -p /mnt/user-data/outputs/video-stream-ingestion && python /mnt/skills/custom/video-stream-ingestion/scripts/run.py --video /mnt/datasets/Vedio-demo/Trafic.mp4 --camera-id CAM_DEERFLOW_001 --source-type local_file --capture-seconds 10 --config /mnt/skills/custom/configs/deerflow_config.json --output /mnt/user-data/outputs/video-stream-ingestion/result.json"},"id":"call_daa51687eaf148b6adc9ff0f","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":9702,"output_tokens":147,"total_tokens":9849,"input_token_details":{},"output_token_details":{"reasoning":0}}},{"content":"{\n  \"skill\": \"video-stream-ingestion\",\n  \"version\": \"1.0.0\",\n  \"status\": \"success\",\n  \"confidence\": 1.0,\n  \"data\": {\n    \"camera_id\": \"CAM_DEERFLOW_001\",\n    \"source_type\": \"local_file\",\n    \"file_status\": \"ok\",\n    \"video_session_id\": \"VS_91e27b0f\",\n    \"started_at\": \"2026-05-20T10:00:00+08:00\",\n    \"ended_at\": \"2026-05-20T10:00:10+08:00\",\n    \"raw_segment_uri\": \"/mnt/datasets/Vedio-demo/Trafic.mp4\",\n    \"duration_seconds\": 10,\n    \"width\": 1280,\n    \"height\": 674\n  }\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"bash","id":"5b514ce8-bf4f-42b3-9bbe-bec237134669","tool_call_id":"call_daa51687eaf148b6adc9ff0f","artifact":null,"status":"success"}],"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/0f35a3ac-6437-4bbd-82f8-4b3844965641/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/0f35a3ac-6437-4bbd-82f8-4b3844965641/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/0f35a3ac-6437-4bbd-82f8-4b3844965641/user-data/outputs"},"viewed_images":{},"artifacts":[]}

