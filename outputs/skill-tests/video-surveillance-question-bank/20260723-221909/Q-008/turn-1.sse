8 的片段保存下来。","scene":"program_snippet","input_refs":[],"task_types":[],"selected_skills":[{"id":"code-semantic-labeler","role":"primary","score":1.0,"reason":null},{"id":"code-splitter-adapter","role":"supporting","score":1.0,"reason":null},{"id":"code-to-ast-new","role":"supporting","score":1.0,"reason":null},{"id":"dataflow-extractor","role":"supporting","score":1.0,"reason":null},{"id":"opengrep-compliance","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["code-semantic-labeler","code-splitter-adapter","code-to-ast-new","dataflow-extractor","opengrep-compliance"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["code-semantic-labeler","code-splitter-adapter","code-to-ast-new","dataflow-extractor","opengrep-compliance"],"selection_owner":"lead_agent","_source_message_key":"id:156fc78b-bdb2-4ac3-a2b3-7d4744e62ab5"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["code-semantic-labeler","code-splitter-adapter","code-to-ast-new","dataflow-extractor","opengrep-compliance"],"allowed_tool_names":[]}

