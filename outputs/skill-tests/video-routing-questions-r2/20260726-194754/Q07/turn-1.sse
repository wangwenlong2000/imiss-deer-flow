":"事件","分析目标":"按告警置信度、证据完整性和潜在影响分级分类"}}],"task_hints":["提取必填参数：分析对象。需要分析的网络流量文件、数据集或场景名称，如 pcap、pcapng、Neris、DNS、HTTP、TLS、会话日志等","提取可选参数：分析目标。用户希望识别、统计或总结的目标，如异常通信、恶意流量、协议分布、主机行为、IOC、攻击链等","提取可选参数：输出形式。用户期望的结果形式，如 summary、报告、表格、图表、证据清单等"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:65984f46-c5c1-4d9a-ab7c-f5aec379050e"},"routing_context":{"route_mode":"scene_filter","trigger":false,"primary_goal":"请根据告警置信度、证据完整性和潜在影响，把事件分成自动通过、需要人工复核和优先复核三类。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"请根据告警置信度、证据完整性和潜在影响，把事件分成自动通过、需要人工复核和优先复核三类。","scene":"network_traffic","input_refs":[],"task_types":[],"selected_skills":[],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":[],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":0.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":[],"selection_owner":"lead_agent","_source_message_key":"id:65984f46-c5c1-4d9a-ab7c-f5aec379050e"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":[],"allowed_tool_names":[]}

