多目标检测与跨帧关联跟踪模型，对画面内所有车辆进行独立ID分配与连续性锁定，提取每辆车的首尾出现帧号及对应精确时间戳作为关键依据。\\n3. 接入时空轨迹场景能力，将步骤2输出的车辆ID序列映射至二维坐标空间，通过时序插值补全路径点，依据边界穿越规则判定进入与离开时刻，结合坐标变化向量计算行驶方向，生成原始轨迹记录。\\n4. 执行数据交叉研判与结构化封装，校验轨迹断点与方向突变等异常情况，剔除无效跟踪片段，最终按统一字段模板汇总输出包含进入时间、离开时间、轨迹坐标序列及行驶方向的标准化结果表。\\n场景任务：\\n- video_surveillance: 持续跟踪画面中的每辆车；参数：{'视频对象': '画面', '监控目标': '每辆车'}\\n- spatiotemporal_trajectory: 生成车辆的进入时间、离开时间、运动轨迹和行驶方向；参数：{'分析对象': '每辆车'}\\n</hidden_step>\\n</system_reminder>\"\n    },\n    \"inputs\": {\n      \"parameters\": {}\n    },\n    \"routing\": {\n      \"selected_skill\": \"video-object-analytics\",\n      \"allowed_skills\": [\n        \"analyze-video\",\n        \"analyze_event_impact\",\n        \"analyze_od_flow\",\n        \"analyze_region_heat\",\n        \"analyze_spatiotemporal_accessibility\",\n        \"anonymize_trajectory_data\",\n        \"batch-video-ingestion\",\n        \"camera-health-check\",\n        \"city-video-intelligence\",\n        \"classify_trajectory_state\",\n        \"clean_trajectory\",\n        \"detect_flow_anomaly\",\n        \"detect_route_anomaly\",\n        \"detect_trajectory_cooccurrence\",\n        \"duplicate-event-merge\",\n        \"evidence-package-generation\",\n        \"evidence-snapshot\",\n        \"extract_stay_points\",\n        \"ffmpeg-utils\",\n        \"forecast_region_flow\",\n        \"frame-sampling\",\n        \"fuse_spatial_evidence\",\n        \"human-review-routing\",\n        \"map_spatial_grid\",\n        \"measure_spatiotemporal_entropy\",\n        \"mine_trajectory_patterns\",\n        \"object-detection\",\n        \"object-statistics\",\n        \"object-tracking\",\n        \"predict_next_location\",\n        \"privacy-masking\",\n        \"profile_urban_region\",\n        \"roi-mapping\",\n        \"search_similar_trajectory\",\n        \"search_spatiotemporal\",\n        \"single-video-event-analysis\",\n        \"video-embedding-index\",\n        \"video-object-analytics\",\n        \"video-search\",\n        \"video-segment-extraction\",\n        \"video-stream-ingestion\"\n      ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/video-object-analytics\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/video-object-analytics/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/video-object-analytics\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"9b7cfc35-88d8-46c6-b360-576018c0aae9","tool_call_id":"call_c2cc25bac009436e842c3063","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":81,"prompt_tokens":16267,"total_tokens":16348,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":14,"rejected_prediction_tokens":null,"text_tokens":81},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":16267}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-adc234e3-4cd9-98f7-8aca-4566250d2b8c","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e6b-3894-7591-9944-ab532e190eb3-0","tool_calls":[{"name":"read_file","args":{"description":"读取视频对象分析技能的 SKILL.md 文件以了解工作流程","path":"/mnt/skills/custom/video_surveillance/video-object-analytics/SKILL.md"},"id":"call_af6c64f6088e4f7c99ace8fd","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":16267,"output_tokens":81,"total_tokens":16348,"input_token_details":{},"output_token_details":{"reasoning":14}}},{"content":"---\nname: video-object-analytics\ndescription: Deterministic structured entrypoint for local-video object detection and cross-frame tracking. Use for direct requests to count visible people, vehicles, or other objects, or to track them across frames. The dedicated video_object_analytics tool owns all CLI parameters, model configuration, persistent paths, and downstream skill order.\n---\n\n# Video Object Analytics\n\nThis skill is the structured entrypoint for direct object detection and tracking requests.\n\n## Mandatory execution rule\n\nCall the `video_object_analytics` tool. Do not call `bash`, `frame-sampling`, `object-detection`, or `object-tracking` scripts directly for this workflow. Do not invent CLI flags.\n\nThe tool accepts structured fields only:\n\n- `video_path`\n- `operation`: `detect` or `track`\n- `camera_id`\n- `capture_seconds`\n- `interval_seconds`\n- `labels`\n\nThe tool internally runs the fixed chain:\n\n```text\ndetect: frame-sampling -> object-detection\ntrack:  frame-sampling -> object-detection -> object-tracking\n```\n\nAll intermediate files are placed under the thread's `/mnt/user-data/workspace` directory and the local YOLO model is selected by the tool. Do not use `/tmp` for artifacts that another tool must read.\n\n## Output contract\n\nReturn the tool's structured result. Use its `summary`, `track_summary`, `artifacts`, and `executed_skills` fields. Do not manually recalculate counts from raw JSON or claim a confidence threshold that is not present in the tool result.\n\n## Constraints\n\n- YOLO detects visible objects only; it does not decide whether an event occurred.\n- Tracking output is object-level trajectory analytics only; it does not infer events or identities.\n- If the tool returns `status=failed`, report its concrete error and stop instead of trying alternative shell commands.\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"c4fa5681-a263-48b0-8460-adf4347c122a","tool_call_id":"call_af6c64f6088e4f7c99ace8fd","artifact":null,"status":"success"},{"content":"现在调用视频对象分析工具进行跨帧跟踪：\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":175,"prompt_tokens":16739,"total_tokens":16914,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":35,"rejected_prediction_tokens":null,"text_tokens":175},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":16739}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-c6fd711d-c059-90b3-8df6-be497ca6ca76","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e6b-4103-7e81-809b-1537a1eb7db7-0","tool_calls":[{"name":"video_object_analytics","args":{"video_path":"/mnt/user-data/uploads/Trafic-30s.mp4","operation":"track","camera_id":"CAM_DEERFLOW_001","capture_seconds":30,"interval_seconds":1,"labels":"[\"car\", \"truck\", \"bus\"]"},"id":"call_892555b2edc04d39a936da34","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":16739,"output_tokens":175,"total_tokens":16914,"input_token_details":{},"output_token_details":{"reasoning":35}}},{"content":"{\"skill\": \"video-object-analytics\", \"status\": \"success\", \"operation\": \"track\", \"executed_skills\": [\"video-object-analytics\", \"frame-sampling\", \"object-detection\", \"object-tracking\"], \"model\": \"/mnt/skills/custom/video_surveillance/models/yolov8n.pt\", \"artifacts\": {\"frames_json\": \"/mnt/user-data/workspace/video-object-analytics/e0077e927f92/frames.json\", \"detections_json\": \"/mnt/user-data/workspace/video-object-analytics/e0077e927f92/detections.json\", \"tracks_json\": \"/mnt/user-data/workspace/video-object-analytics/e0077e927f92/tracks.json\"}, \"summary\": {\"frame_count\": 30, \"per_frame\": [{\"frame_id\": \"CAM_DEERFLOW_001_202605201000000800_0001\", \"timestamp\": \"2026-05-20T10:00:00+08:00\", \"counts\": {\"bus\": 2, \"car\": 9}, \"object_count\": 11}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000010800_0002\", \"timestamp\": \"2026-05-20T10:00:01+08:00\", \"counts\": {\"bus\": 2, \"car\": 8}, \"object_count\": 10}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000020800_0003\", \"timestamp\": \"2026-05-20T10:00:02+08:00\", \"counts\": {\"bus\": 1, \"car\": 9}, \"object_count\": 10}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000030800_0004\", \"timestamp\": \"2026-05-20T10:00:03+08:00\", \"counts\": {\"bus\": 1, \"car\": 6}, \"object_count\": 7}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000040800_0005\", \"timestamp\": \"2026-05-20T10:00:04+08:00\", \"counts\": {\"bus\": 2, \"car\": 5}, \"object_count\": 7}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000050800_0006\", \"timestamp\": \"2026-05-20T10:00:05+08:00\", \"counts\": {\"bus\": 1, \"car\": 5}, \"object_count\": 6}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000060800_0007\", \"timestamp\": \"2026-05-20T10:00:06+08:00\", \"counts\": {\"bus\": 1, \"car\": 4}, \"object_count\": 5}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000070800_0008\", \"timestamp\": \"2026-05-20T10:00:07+08:00\", \"counts\": {\"car\": 5}, \"object_count\": 5}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000080800_0009\", \"timestamp\": \"2026-05-20T10:00:08+08:00\", \"counts\": {\"car\": 2}, \"object_count\": 2}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000090800_0010\", \"timestamp\": \"2026-05-20T10:00:09+08:00\", \"counts\": {\"car\": 2}, \"object_count\": 2}, {\"frame_id\": \"CAM_DEERFLOW_001_202605201000100800_0011\", \"timestamp\": \"2026-05-20T10:00:10+08:00\", \"counts\": {}, \"object_count\": 0}, {\"fr