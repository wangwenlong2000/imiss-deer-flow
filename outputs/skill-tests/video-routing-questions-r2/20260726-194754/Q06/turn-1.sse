形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:218623bc-246b-4ecd-8d06-a6db3cbf8513"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic-30s.mp4 (1.5 MB)\n  Path: /mnt/user-data/uploads/Trafic-30s.mp4\n\nYou can read these files using the `read_file` tool with the paths shown above.\n</uploaded_files>\n\n请按每 2 秒从视频中抽取一帧，并为每帧生成包含时间戳、来源和图像尺寸的结构化记录。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic-30s.mp4 (1.5 MB)\n  Path: /mnt/user-data/uploads/Trafic-30s.mp4\n\nYou can read these files using the `read_file` tool with the paths shown above.\n</uploaded_files>\n\n请按每 2 秒从视频中抽取一帧，并为每帧生成包含时间戳、来源和图像尺寸的结构化记录。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:218623bc-246b-4ecd-8d06-a6db3cbf8513"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resu