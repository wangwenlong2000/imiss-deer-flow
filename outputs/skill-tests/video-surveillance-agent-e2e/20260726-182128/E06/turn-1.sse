orting","score":1.0,"reason":null},{"id":"topn-high-risk-discovery","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["association-path-analysis","condition-based-screening","dataset-onboarding-graph-preprocess","dataset-overview-analysis","dataset-quality-and-linkability-diagnostic","gang-cluster-analysis","graph-operator","group-risk-analysis","overlap-analysis","risk-evidence-pack","shared-device-analysis","sichuan-shaanxi-comparison","single-number-analysis","subgraph-extraction-analysis","time-series-anomaly-analysis","topn-high-risk-discovery"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["association-path-analysis","condition-based-screening","dataset-onboarding-graph-preprocess","dataset-overview-analysis","dataset-quality-and-linkability-diagnostic","gang-cluster-analysis","graph-operator","group-risk-analysis","overlap-analysis","risk-evidence-pack","shared-device-analysis","sichuan-shaanxi-comparison","single-number-analysis","subgraph-extraction-analysis","time-series-anomaly-analysis","topn-high-risk-discovery"],"selection_owner":"lead_agent","_source_message_key":"id:22168275-7548-47d3-b77f-f0605db52d74"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["association-path-analysis","condition-based-screening","dataset-onboarding-graph-preprocess","dataset-overview-analysis","dataset-quality-and-linkability-diagnostic","gang-cluster-analysis","graph-operator","group-risk-analysis","overlap-analysis","risk-evidence-pack","shared-device-analysis","sichuan-shaanxi-comparison","single-number-analysis","subgraph-extraction-analysis","time-series-anom