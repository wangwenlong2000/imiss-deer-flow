n        \"batch-video-ingestion\",\n        \"camera-health-check\",\n        \"city-video-intelligence\",\n        \"duplicate-event-merge\",\n        \"evidence-package-generation\",\n        \"evidence-snapshot\",\n        \"ffmpeg-utils\",\n        \"frame-sampling\",\n        \"human-review-routing\",\n        \"object-detection\",\n        \"object-statistics\",\n        \"object-tracking\",\n        \"privacy-masking\",\n        \"roi-mapping\",\n        \"single-video-event-analysis\",\n        \"video-embedding-index\",\n        \"video-object-analytics\",\n        \"video-search\",\n        \"video-segment-extraction\",\n        \"video-stream-ingestion\"\n      ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/video-stream-ingestion\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/video-stream-ingestion/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/video-stream-ingestion\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"b341b280-8fba-4f38-b084-dbc94de5b7f0","tool_call_id":"call_011009a0e3364042a0186680","artifact":null,"status":"success"}],"artifacts":[],"intent_context":{"intent":"task","original_query":"请读取我上传的这个视频的时长、分辨率、帧率和编码信息，整理成后续分析可以直接使用的标准输入。","normalized_query":"请读取我上传的这个视频的时长、分辨率、帧率和编码信息，整理成后续分析可以直接使用的标准输入。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将读取监控场景下上传视频的时长、分辨率、帧率和编码信息，并整理为后续分析可直接使用的标准输入格式","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"上传的视频","输出形式":"标准输入格式"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_db8274","text":"请读取我上传的这个视频的时长、分辨率、帧率和编码信息，整理成后续分析可以直接使用的标准输入。"}],"planning_steps":[{"task_span_id":"span_b4efbd","text":"调用视频元数据解析能力，对已上传的视频文件进行底层读取与结构化解析，精准提取时长、分辨率、帧率与编码格式四项核心参数，并校验字段完整性与数据类型有效性，输出原始参数清单。"},{"task_span_id":"span_143bc4","text":"基于视频监控场景的数据接入规范，将原始参数清单转换为统一的标准化键值结构，对异常或缺失值进行合规性标记与默认值填充，生成符合下游分析模块接收协议的标准化输入数据包。"},{"task_span_id":"span_2976b4","text":"将标准化输入数据包与视频对象标识及监控业务上下文进行映射绑定，封装为可追溯的任务初始化配置项，按顺序交付至后续智能体以支撑视频流处理、目标检测或事件告警等分析流程。"}],"scene_tasks":[{"sub_task_id":"sub_df5eed","scene":"video_surveillance","scene_name":"视频监控","text":"我将读取监控场景下上传视频的时长、分辨率、帧率和编码信息，并整理为后续分析可直接使用的标准输入格式。","params":{"视频对象":"上传的视频","输出形式":"标准输入格式"}}],"sub_tasks":[{"sub_task_id":"sub_df5eed","scene":"video_surveillance","scene_name":"视频监控","text":"我将读取监控场景下上传视频的时长、分辨率、帧率和编码信息，并整理为后续分析可直接使用的标准输入格式。","params":{"视频对象":"上传的视频","输出形式":"标准输入格式"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:5f0d7e60-ab40-4650-acc7-e2d492e7f782"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic.mp4 (72.4 MB)\n  Path: /mnt/user-data/uploads/Trafic.mp4\n\nYou can read these files using the `read_file` tool with the paths shown above.\n</uploaded_files>\n\n请读取我上传的这个视频的时长、分辨率、帧率和编码信息，整理成后续分析可以直接使用的标准输入。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic.mp4 (72.4 MB)\n  Path: /mnt/user-data/uploads/Trafic.mp4\n\nYou can read these files using the `read_file` tool with the paths shown above.\n</uploaded_files>\n\n请读取我上传的这个视频的时长、分辨率、帧率和编码信息，整理成后续分析可以直接使用的标准输入。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:5f0d7e60-ab40-4650-acc7-e2d492e7f782"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extr