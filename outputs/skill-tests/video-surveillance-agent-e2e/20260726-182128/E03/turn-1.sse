 \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_004\",\n            \"label\": \"car\",\n            \"confidence\": 0.5964,\n            \"bbox\": [\n              22.91,\n              197.97,\n              92.08,\n              240.83\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_005\",\n            \"label\": \"car\",\n            \"confidence\": 0.5668,\n            \"bbox\": [\n              94.33,\n              197.16,\n              170.98,\n              251.04\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_006\",\n            \"label\": \"car\",\n            \"confidence\": 0.5411,\n            \"bbox\": [\n              642.46,\n              148.25,\n              677.17,\n              173.39\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_007\",\n            \"label\": \"car\",\n            \"confidence\": 0.5079,\n            \"bbox\": [\n              451.57,\n              159.67,\n              495.42,\n              194.42\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_008\",\n            \"label\": \"car\",\n            \"confidence\": 0.5007,\n            \"bbox\": [\n              94.61,\n              209.94,\n              149.35,\n              250.35\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_009\",\n            \"label\": \"car\",\n            \"confidence\": 0.497,\n            \"bbox\": [\n              175.65,\n              168.91,\n              226.68,\n              209.11\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_010\",\n            \"label\": \"ca