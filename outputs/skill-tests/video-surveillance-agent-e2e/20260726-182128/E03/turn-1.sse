start_time\": \"2026-05-20T10:00:00+08:00\",\n        \"end_time\": \"2026-05-20T10:00:00+08:00\",\n        \"duration_seconds\": 0,\n        \"last_bbox\": [\n          773.71,\n          171.49,\n          804.52,\n          195.68\n        ],\n        \"trajectory\": [\n          [\n            747.75,\n            178.2\n          ],\n          [\n            789.12,\n            183.59\n          ]\n        ],\n        \"movement_state\": \"stationary\",\n        \"confidence\": 0.4748,\n        \"evidence_frame_ids\": [\n          \"CAM_DEERFLOW_001_202605201000000800_0001\",\n          \"CAM_DEERFLOW_001_202605201000000800_0001\"\n        ]\n      },\n      {\n        \"track_id\": \"track_0008\",\n        \"camera_id\": \"CAM_DEERFLOW_001\",\n        \"label\": \"car\",\n        \"start_time\": \"2026-05-20T10:00:00+08:00\",\n        \"end_time\": \"2026-05-20T10:00:03+08:00\",\n        \"duration_seconds\": 3,\n        \"last_bbox\": [\n          1163.04,\n          205.84,\n          1279.04,\n          244.18\n        ],\n        \"trajectory\": [\n          [\n            1221.51,\n            225.34\n          ],\n          [\n            1221.93,\n            226.0\n          ],\n          [\n            1221.03,\n            226.44\n          ],\n          [\n            1221.04,\n            225.01\n          ]\n        ],\n        \"movement_state\": \"stationary\",\n        \"confidence\": 0.3881,\n        \"evidence_frame_ids\": [\n          \"CAM_DEERFLOW_001_202605201000000800_0001\",\n          \"CAM_DEERFLOW_001_202605201000010800_0002\",\n          \"CAM_DEERFLOW_001_202605201000020800_0003\",\n          \"CAM_DEERFLOW_001_202605201000030800_0004\"\n        ]\n      },\n      {\n        \"track_id\": \"track_0009\",\n        \"camera_id\": \"CAM_DEERFLOW_001\",\n        \"label\": \"car\",\n        \"start_time\": \"2026-05-20T10:00:01+08:00\",\n        \"end_time\": \"2026-05-20T10:00:01+08:00\",\n        \"duration_seconds\": 0,\n        \"