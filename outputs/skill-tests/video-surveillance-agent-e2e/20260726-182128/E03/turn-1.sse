\n              250.99\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0005_007\",\n            \"label\": \"car\",\n            \"confidence\": 0.3771,\n            \"bbox\": [\n              133.49,\n              171.18,\n              207.92,\n              219.68\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0005_008\",\n            \"label\": \"car\",\n            \"confidence\": 0.3592,\n            \"bbox\": [\n              492.46,\n              170.86,\n              537.31,\n              210.44\n            ],\n            \"model_label\": \"car\"\n          }\n        ]\n      },\n      {\n        \"frame_id\": \"CAM_DEERFLOW_001_202605201000050800_0006\",\n        \"timestamp\": \"2026-05-20T10:00:05+08:00\",\n        \"objects\": [\n          {\n            \"object_id\": \"det_0006_001\",\n            \"label\": \"car\",\n            \"confidence\": 0.782,\n            \"bbox\": [\n              478.27,\n              188.81,\n              525.12,\n              231.23\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0006_002\",\n            \"label\": \"bus\",\n            \"confidence\": 0.6853,\n            \"bbox\": [\n              588.42,\n              102.73,\n              636.77,\n              162.44\n            ],\n            \"model_label\": \"bus\"\n          },\n          {\n            \"object_id\": \"det_0006_003\",\n            \"label\": \"car\",\n            \"confidence\": 0.5972,\n            \"bbox\": [\n              62.3,\n              200.09,\n              135.79,\n              254.81\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0006_004\",\n            \"label\": \"car\",\n            \"confidence\": 0.5255,\n            \"bbox\": [\n              4