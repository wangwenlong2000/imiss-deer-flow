     ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/human-review-routing\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/human-review-routing/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/human-review-routing\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"8c8767ac-11d0-42c8-9e4f-96f5fc03e7da","tool_call_id":"call_4c6b0d6255f64739ab0f9d05","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":91,"prompt_tokens":14553,"total_tokens":14644,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":27,"rejected_prediction_tokens":null,"text_tokens":91},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":14553}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-98ef0261-8446-9fb5-bf3f-0b0aad7689ca","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e01-0e56-75e1-9e25-118c59f68275-0","tool_calls":[{"name":"read_file","args":{"description":"读取人工复核路由技能的完整工作流文档","path":"/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md"},"id":"call_7cd3d5def2854f3a83ab20b7","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":14553,"output_tokens":91,"total_tokens":14644,"input_token_details":{},"output_token_details":{"reasoning":27}}},{"content":"---\nname: human-review-routing\ndescription: Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.\n---\n\n# Human Review Routing\n\n## Execution Priority\n\nPrioritize calling this skill's `scripts/run.py` entrypoint first. Only write custom code after the script result is unsuitable or the script cannot cover the requested task.\n\n## Input Resolution\n\nIf event confidence or event fields are missing but the user provided a video analysis request, first call `single-video-event-analysis` to produce candidate events, then call this skill for review routing.\n\n\n## Atomic CLI\n\nRun this skill directly with its own script. The script does not call other skill scripts and does not depend on shared `src`, `tools`, or registry modules.\n\n```bash\npython human-review-routing/scripts/run.py --event-json <event.json> --camera-health-json <health.json> --config <config.json> --output <review.json>\n```\n\nParameters: `--event-json`, `--camera-health-json`, `--review-threshold`, `--config`, `--output`.\n\n## Workflow\n\n1. Read event confidence, event type, camera health, and review threshold.\n2. Require review for low confidence, high-risk types, degraded cameras, new cameras, or enforcement impact.\n3. Return review flag, reasons, threshold, and queue.\n\n## Available Implementation\n\nThis skill is implemented as an atomic standalone script in its own `scripts/run.py`. The script contains the executable logic for this skill and must not import shared `src`, `tools`, or registry modules.\n\n## Inputs\n\n- `event`\n- `camera_health`\n- Optional `review_threshold`\n\nConfig:\n- `default_review_threshold`\n- `review_thresholds.<event_type>`\n- `high_risk_event_types`\n\n## Outputs\n\nReturns `event_id`, `review_required`, `reasons`, `review_threshold`, and `queue`.\n\n## Failure Modes\n\nThe current implementation tolerates missing optional config and falls back to threshold `0.85`.\n\n## Constraints\n\nDo not merge duplicate events or generate evidence.\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"58fdb046-c67a-419c-b881-35ca74490578","tool_call_id":"call_7cd3d5def2854f3a83ab20b7","artifact":null,"status":"success"}],"artifacts":[],"intent_context":{"intent":"task","original_query":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","normalized_query":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将明确在视频监控场景中事件置信度低、摄像头画面有遮挡或事件涉及执法时必须进入人工复核的具体结果","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"","监控目标":"","时间范围":"","输出形式":""},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_9f02ff","text":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？"}],"planning_steps":[{"task_span_id":"span_4db67e","text":"检索并解析视频监控系统的模型部署文档与现行安防巡检SOP，定向提取目标检测置信度阈值、画面遮挡率测算公式及涉法事件取证规范等关键字段，完成非结构化规则的数字化转译，产出基础参数与判定依据对照表。"},{"task_span_id":"span_6b3e13","text":"依托已解析的判定依据，将“置信度低于设定阈值”“画面有效可视面积不足”“涉及人员控制或证据固定”三类触发条件，逐项映射至系统输出的异常告警、目标轨迹中断记录及现场音视频切片，明确各结果类型的识别口径与容错区间，生成条件-结果映射矩阵。"},{"task_span_id":"span_5928de","text":"结合误报漏报概率指标与执法合规审查红线，对映射矩阵中的结果类型进行风险分级与必要性筛查，划定自动化过滤阈值与人工复核切换节点，形成带优先级权重的必审结果清单。"},{"task_span_id":"span_4c803e","text":"规划复核工单的数据封装与流转协议，明确人工复核环节必须调取的原生视频帧、检测框坐标、模型推理日志及时间窗范围等上下文要素，并定义复核结论的结构化回传格式，输出上下文挂载与交互规范。"},{"task_span_id":"span_c22503","text":"串联参数提取、条件映射、分级筛查与上下文规范等阶段性产出，编制《视频监控事件人工复核执行调度计划》，明确各子任务的依赖关系与执行序列，供下游数据解析、规则匹配、队列调度及报告生成智能体按序调用。"}],"scene_tasks":[{"sub_task_id":"sub_3d82a1","scene":"video_surveillance","scene_name":"视频监控","text":"我将明确在视频监控场景中事件置信度低、摄像头画面有遮挡或事件涉及执法时必须进入人工复核的具体结果。","params":{}}],"sub_tasks":[{"sub_task_id":"sub_3d82a1","scene":"video_surveillance","scene_name":"视频监控","text":"我将明确在视频监控场景中事件置信度低、摄像头画面有遮挡或事件涉及执法时必须进入人工复核的具体结果。","params":{}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:6b88d24d-f23b-4472-aae8-995d33ec7ccd"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:6b88d24d-f23b-4472-aae8-995d33ec7ccd"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":nu