ng-cluster-analysis","role":"supporting","score":1.0,"reason":null},{"id":"graph-operator","role":"supporting","score":1.0,"reason":null},{"id":"group-risk-analysis","role":"supporting","score":1.0,"reason":null},{"id":"overlap-analysis","role":"supporting","score":1.0,"reason":null},{"id":"risk-evidence-pack","role":"supporting","score":1.0,"reason":null},{"id":"shared-device-analysis","role":"supporting","score":1.0,"reason":null},{"id":"sichuan-shaanxi-comparison","role":"supporting","score":1.0,"reason":null},{"id":"single-number-analysis","role":"supporting","score":1.0,"reason":null},{"id":"subgraph-extraction-analysis","role":"supporting","score":1.0,"reason":null},{"id":"time-series-anomaly-analysis","role":"supporting","score":1.0,"reason":null},{"id":"topn-high-risk-discovery","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["association-path-analysis","condition-based-screening","dataset-onboarding-graph-preprocess","dataset-overview-analysis","dataset-quality-and-linkability-diagnostic","gang-cluster-analysis","graph-operator","group-risk-analysis","overlap-analysis","risk-evidence-pack","shared-device-analysis","sichuan-shaanxi-comparison","single-number-analysis","subgraph-extraction-analysis","time-series-anomaly-analysis","topn-high-risk-discovery"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["association-path-analysis","condition-based-screening","dataset-onboarding-graph-preprocess","dataset-overview-analysis","dataset-quality-and-linkability-diagnostic","gang-cluster-analysis","graph-operator","group-risk-analysis","overlap-analysis","risk-evidence-pack","shared-device-analysis","sichuan-shaanxi-comparison","single-number-analysis","subgraph-extraction-analysis","time-series-anomaly-analysis","topn-high-risk-discovery