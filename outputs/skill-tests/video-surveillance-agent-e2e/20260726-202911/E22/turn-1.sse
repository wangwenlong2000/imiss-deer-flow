 size: 1.5 MB\nPass 0: Scene detection (threshold=0.3)...\n  Detected 0 scene changes.\nPass 1: Coarse sweep at 1.0 fps...\n  Chapter 1/1: 30 frames (0:00:00.000 - 0:00:30.000)\n  Coarse pass complete: 30 frames.\nPass 2: No scene changes -- skipping dense extraction.\n\nExtraction complete in 0.5s:\n  Total frames: 30\n  Scene changes: 0\n  Chapters: 1\n  Passes: scene_detect, coarse, dense\n  Output: /mnt/user-data/workspace/video_review\n  Metadata: /mnt/user-data/workspace/video_review/metadata.json\n{\"status\": \"success\", \"output_dir\": \"/mnt/user-data/workspace/video_review\", \"metadata\": \"/mnt/user-data/workspace/video_review/metadata.json\", \"total_frames\": 30, \"total_scene_changes\": 0, \"chapters\": 1, \"video_duration\": 30.0, \"passes\": [\"scene_detect\", \"coarse\", \"dense\"]}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"bash","id":"51e5651a-e2c9-4487-a3b8-58bc1f361539","tool_call_id":"call_09e029f46ca64efdbe7ea9bd","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":100,"prompt_tokens":15695,"total_tokens":15795,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":40,"rejected_prediction_tokens":null,"text_tokens":100},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":15695}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-87d3c308-6b97-95a6-9e3c-40113a456c05","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e7d-1cc2-79d1-8e38-eeea4dad7356-0","tool_calls":[{"name":"read_file","args":{"description":"读取视频元数据，了解章节和关键帧信息","path":"/mnt/user-data/workspace/video_review/metadata.json"},"id":"call_f503d823a5354cca97ad4c0a","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":15695,"output_tokens":100,"total_tokens":15795,"input_token_details":{