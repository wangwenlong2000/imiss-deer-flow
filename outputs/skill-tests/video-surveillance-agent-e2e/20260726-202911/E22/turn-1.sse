,\n        \"duplicate-event-merge\",\n        \"evidence-package-generation\",\n        \"evidence-snapshot\",\n        \"ffmpeg-utils\",\n        \"frame-sampling\",\n        \"human-review-routing\",\n        \"object-detection\",\n        \"object-statistics\",\n        \"object-tracking\",\n        \"privacy-masking\",\n        \"roi-mapping\",\n        \"single-video-event-analysis\",\n        \"video-embedding-index\",\n        \"video-object-analytics\",\n        \"video-search\",\n        \"video-segment-extraction\",\n        \"video-stream-ingestion\"\n      ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/analyze-video\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/analyze-video/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/analyze-video\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"7d122d8a-8cc5-427e-84ec-0991e1fd8db6","tool_call_id":"call_939331d4152b4da3ae4fda4b","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":81,"prompt_tokens":14433,"total_tokens":14514,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":13,"rejected_prediction_tokens":null,"text_tokens":81},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":14433}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-9610afcc-38a6-9d21-ba54-86c4b461956c","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e7c-ec26-73b0-b04b-ac370cbafc29-0","tool_calls":[{"name":"read_file","args":{"description":"读取 analyze-video 技能文件，了解场景检测和帧提取的工作流","path":"/mnt/skills/custom/video_surveillance/analyze-video/SKILL.md"},"id":"call_ac8f8f48c2db40a99efba08b","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":14433,"output_tokens":81,"total_tokens":14514,"input_token_details":{},"output_token_details":{"reasoning":13}}},{"content":"---\nname: analyze-video\ndescription: 专业视频抽帧与取证准备技能。支持场景检测、多阶段帧提取和 metadata 生成，供 single-video-event-analysis 做 LLM 审帧使用；本 skill 不再作为最终事件检测入口。\nversion: 1.0.0\nauthor: jdrodriguez\ncompatibility: \">=2.0.0\"\nallowed-tools:\n  - bash\n  - read_file\n  - write_file\n---\n\n# 专业视频抽帧取证准备技能 (Analyze Video)\n\n## Execution Priority\n\nPrioritize calling this skill's `scripts/extract_frames.py` entrypoint to produce timestamped frames and metadata. For final event detection, use `single-video-event-analysis`.\n\n## 技能说明\n`analyze-video` 是一个高精度的视频抽帧和取证准备工具。它通过 `ffmpeg` 在本地执行场景变更检测，并自动将长视频划分为多个“章节”，为后续 LLM 审帧提供可回放、可审计的帧证据。\n\n## 核心能力\n- **自动分段**：自动识别视频中的重要场景并进行章节切分。\n- **自适应抓图**：在场景剧烈变化处自动增加抓拍频率，确保不遗漏关键动作。\n- **审帧准备**：输出便于 LLM 审查的帧目录和 `metadata.json`。\n- **结构化帧元数据**：为每一帧生成精确的时间戳和元数据。\n\n## 触发关键词\n- \"视频抽帧\", \"场景检测\", \"关键帧提取\", \"取证准备\", \"视频回溯\", \"analyze-video\", \"metadata.json\"\n\n## 权限声明\n- `bash`: 用于执行 `python3 /mnt/skills/custom/analyze-video/scripts/extract_frames.py`。\n- `ffmpeg`: 核心依赖。\n\n## 操作规范 (Guidelines)\n1. **工作流程**：\n   - 调用：`python3 /mnt/skills/custom/analyze-video/scripts/extract_frames.py <video_path> --output-dir /mnt/user-data/workspace/video_review`。\n   - 读取产生的 `metadata.json` 了解视频章节、场景变化和帧分布。\n   - 如需最终事件检测，交给 `single-video-event-analysis` 统一完成。\n2. **注意事项**：\n   - 提取过程可能耗时较长（视视频长度而定）。\n   - 本 skill 不输出最终事件类型、事件置信度或人工复核结论。\n\n## 示例 (Example)\n**用户：** \"把 `/mnt/datasets/surveillance/raw/test_video_01.mp4` 抽帧用于取证。\"\n**Agent 动作：**\n- 执行：`python3 /mnt/skills/custom/analyze-video/scripts/extract_frames.py /mnt/datasets/surveillance/raw/test_video_01.mp4`\n- 根据输出的 `output_dir` 读取元数据。\n- 回复用户： \"视频提取完成，共识别出 3 个关键场景，可交给 single-video-event-analysis 做事件审查。\"\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"1f4e87cd-5adf-4548-b6b3-cd041ae1b9ba","tool_call_id":"call_ac8f8f48c2db40a99efba08b","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":88,"prompt_tokens":15164,"total_tokens":15252,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":27,"rejected_prediction_tokens":null,"text_tokens":88},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":15164}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-554d6683-a3f6-92b4-b5f6-9073ca7c9b60","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e7d-0561-7483-8a23-216c5d74d24c-0","tool_calls":[{"name":"bash","args":{"command":"ls /mnt/skills/custom/video_surveillance/analyze-video/scripts/","description":"检查 extract_frames.py 脚本是否存在"},"id":"call_b828015eb37f470881470764","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":15164,"output_tokens":88,"total_tokens":15252,"input_token_details":{},"output_token_details":{"reasoning":27}}}],"uploaded_files":[{"filename":"Trafic-30s.mp4","size":1533354,"path":"/mnt/user-data/uploads/Trafic-30s.mp4","extension":".mp4"}],"viewed_images":{},"intent_context":{"intent":"task","original_query":"请按画面场景变化，把这段录像切成若干章节，并为每个章节抽一张关键帧，只准备素材不下结论。","normalized_query":"请按画面场景变化，把这段录像切成若干章节，并为每个章节抽一张关键帧，只准备素材不下结论。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将按画面场景变化把这段视频监控录像切成若干章节，为每个章节抽取一张关键帧，仅准备纯素材不下结论","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"这段录像","输出形式":"章节切割、关键帧截图、纯素材"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_99439d","text":"请按画面场景变化，把这段录像切成若干章节，并为每个章节抽一张关键帧，只准备素材不下结论。"}],"planning_steps":[{"task_span_id":"span_ae867c","text":"读取并解析输入的视频监控录像文件，提取视频基础参数（如时长、帧率、编码格式），完成解码初始化与帧流加载，输出标准化的视频数据结构以供后续处理。"},{"task_span_id":"span_0892fd","text":"依托视频监控场景的时序帧分析能力，对连续视频帧进行视觉特征比对与场景过渡检测，依据画面内容突变程度设定切分阈值，识别出所有场景变化的时间节点，输出各章节的起止时间戳或帧索引清单。"},{"task_span_id":"span_3f7afe","text":"基于已划分的章节区间定位对应帧序列，采用特征保留度最高的策略为每个章节抽取单张关键帧截图，将章节编号、时间范围与关键帧图像文件进行配对归档，仅输出纯素材包，不生成任何研判结论或说明。"}],"scene_tasks":[{"sub_task_id":"sub_060f47","scene":"video_surveillance","scene_name":"视频监控","text":"我将按画面场景变化把这段视频监控录像切成若干章节，为每个章节抽取一张关键帧，仅准备纯素材不下结论。","params":{"视频对象":"这段录像","输出形式":"章节切割、关键帧截图、纯素材"}}],"sub_tasks":[{"sub_task_id":"sub_060f47","scene":"video_surveillance","scene_name":"视频监控","text":"我将按画面场景变化把这段视频监控录像切成若干章节，为每个章节抽取一张关键帧，仅准备纯素材不下结论。","params":{"视频对象":"这段录像","输出形式":"章节切割、关键帧截图、纯素材"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:81e4cfff-2c8f-4102-a376-46ccfa551f7f"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic-30s.mp4 (1.5 MB)\n  Path: /mnt/user-data/uploads/Trafic-30s.mp4\n\nYou can read these files using the `read_file` tool with the paths shown