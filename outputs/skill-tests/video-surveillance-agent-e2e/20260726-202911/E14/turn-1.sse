"car\",\n            \"confidence\": 0.6144,\n            \"bbox\": [\n              23.05,\n              197.94,\n              90.95,\n              241.24\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_005\",\n            \"label\": \"car\",\n            \"confidence\": 0.5729,\n            \"bbox\": [\n              94.1,\n              197.61,\n              171.36,\n              251.35\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_006\",\n            \"label\": \"car\",\n            \"confidence\": 0.5511,\n            \"bbox\": [\n              642.22,\n              147.27,\n              678.12,\n              172.35\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_007\",\n            \"label\": \"car\",\n            \"confidence\": 0.5049,\n            \"bbox\": [\n              94.08,\n              209.6,\n              149.91,\n              250.94\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_008\",\n            \"label\": \"car\",\n            \"confidence\": 0.4457,\n            \"bbox\": [\n              451.37,\n              159.77,\n              495.67,\n              194.66\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_009\",\n            \"label\": \"car\",\n            \"confidence\": 0.378,\n            \"bbox\": [\n              174.85,\n              169.3,\n              226.06,\n              208.46\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_010\",\n            \"label\": \"car\",\n            \"confidence\": 0.3726,\n            \"bbox\": [\n              259.88,\n              212.03,\n             