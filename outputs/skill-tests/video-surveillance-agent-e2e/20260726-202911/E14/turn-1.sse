  \"label\": \"car\",\n            \"confidence\": 0.8154,\n            \"bbox\": [\n              468.18,\n              227.26,\n              531.07,\n              280.53\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_002\",\n            \"label\": \"bus\",\n            \"confidence\": 0.8029,\n            \"bbox\": [\n              575.34,\n              139.15,\n              643.61,\n              236.98\n            ],\n            \"model_label\": \"bus\"\n          },\n          {\n            \"object_id\": \"det_0003_003\",\n            \"label\": \"car\",\n            \"confidence\": 0.7531,\n            \"bbox\": [\n              425.12,\n              350.8,\n              519.45,\n              442.67\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_004\",\n            \"label\": \"car\",\n            \"confidence\": 0.6144,\n            \"bbox\": [\n              23.05,\n              197.94,\n              90.95,\n              241.24\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_005\",\n            \"label\": \"car\",\n            \"confidence\": 0.5729,\n            \"bbox\": [\n              94.1,\n              197.61,\n              171.36,\n              251.35\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_006\",\n            \"label\": \"car\",\n            \"confidence\": 0.5511,\n            \"bbox\": [\n              642.22,\n              147.27,\n              678.12,\n              172.35\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_007\",\n            \"label\": \"car\",\n            \"confidence\": 0.5049,\n            \"bbox\": [\n              94.08,\n              209.6,\n              149.91,\n              250.94\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_008\",\n            \"label\": \"car\",\n            \"confidence\": 0.4457,\n            \"bbox\": [\n              451.37,\n              159.77,\n              495.67,\n              194.66\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_009\",\n            \"label\": \"car\",\n            \"confidence\": 0.378,\n            \"bbox\": [\n              174.85,\n              169.3,\n              226.06,\n              208.46\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_010\",\n            \"label\": \"car\",\n            \"confidence\": 0.3726,\n            \"bbox\": [\n              259.88,\n              212.03,\n              322.54,\n              276.51\n            ],\n            \"model_label\": \"car\"\n          }\n        ]\n      }\n    ],\n    \"model\": \"/mnt/skills/custom/video_surveillance/models/yolov8n.pt\"\n  }\n}\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"c48f0120-6545-46fb-bcfd-abaddc32577f","tool_call_id":"call_be20a1c5cec84aea960ac7f1","artifact":null,"status":"success"},{"content":"检测结果已获取——当前帧中检测到了多辆汽车和公交车，但未检测到行人。现在我来提取更多视频帧并准备打码处理。\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":387,"prompt_tokens":19335,"total_tokens":19722,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":264,"rejected_prediction_tokens":null,"text_tokens":387},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":19335}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-f4ae13a2-0fc3-9837-8e30-6a27ef29c7b3","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e6d-715b-7cb0-ae60-45945a0b9e42-0","tool_calls":[{"name":"invoke_skill","args":{"skill_name":"frame-sampling","mode":"prepare","input_envelope":"{\"video_path\": \"/mnt/user-data/uploads/Trafic-30s.mp4\", \"camera_id\": \"CAM_DEERFLOW_001\"}"},"id":"call_f00543183e2c48b2baefaa13","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":19335,"output_tokens":387,"total_tokens":19722,"input_token_details":{},"output_token_details":{"reasoning":264}}},{"content":"{\n  \"status\": \"prepared\",\n  \"skill_name\": \"frame-sampling\",\n  \"input_envelope\": {\n    \"schema_version\": \"1.0\",\n    \"request_id\": \"8548f772-3891-4f0c-82dd-b19b20e61f8c\",\n    \"skill_name\": \"frame-sampling\",\n    \"scenario\": \"video_surveillance\",\n    \"capability\": \"skill_invocation\",\n    \"query\": {\n      \"raw\": \"<system_reminder>\\nUse the following current-turn intent and routing guidance when deciding whether to create or update todos. Treat it as planning context, not as a user request.\\n<hidden_step source=\\\"intent_recognition\\\" title=\\\"意图识别\\\">\\n改写后的任务：场景：视频监控。场景ID：video_surveillance\\n识别场景：视频监控 (video_surveillance)；场景模式：single；候选场景：video_surveillance\\n任务切分：\\n- 这段视频要对外提供，请先把画面里的人脸和车牌做打码处理，再给我处理后的图片。\\n任务规划：\\n1. 读取原始视频文件并完成解码与帧结构解析，提取用于对外展示的关键画面片段，校验视频编码格式与分辨率参数，输出结构化帧索引表与待处理素材包。\\n2. 调用计算机视觉目标检测能力对关键帧进行逐帧扫描，精准定位人脸轮廓与车牌字符区域，生成带置信度评分的坐标边界框集合，作为后续隐私遮蔽的空间依据。\\n3. 依据坐标掩码对指定区域执行高斯模糊或像素化打码操作，设定遮蔽强度参数以确保身份特征不可逆还原，同时维持周边场景画质无损，输出局部脱敏后的中间图像序列。\\n4. 执行打码质量交叉验证，核对敏感目标覆盖率与边缘融合效果，确认符合对外发布合规标准后，将处理结果统一转换为目标图片格式并生成可回溯的交付文件包。\\n场景任务：\\n- video_surveillance: 我需要对这段视频进行人脸和车牌打码处理，并将处理后的结果以图片形式输出。；参数：{'视频对象': '这段视频', '监控目标': '人脸、车牌', '输出形式': '图片'}\\n已提取参数：{'视频对象': '这段视频', '监控目标': '人脸、车牌', '输出形式': '图片'}\\n任务提示：\\n- 提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧\\n- 提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等\\n- 提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口\\n- 提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要\\n</hidden_step>\\n</system_reminder>\"\n    },\n    \"inputs\": {\n      \"parameters\": {}\n    },\n    \"routing\": {\n      \"selected_skill\": \"frame-sampling\",\n      \"allowed_skills\": [\n        \"analyze-video\",\n        \"batch-video-ingestion\",\n        \"camera-health-check\",\n        \"city-video-intelligence\",\n        \"duplicate-event-merge\",\n        \"evidence-package-generation\",\n        \"evidence-snapshot\",\n        \"ffmpeg-utils\",\n        \"frame-sampling\",\n        \"human-review-routing\",\n        \"object-detection\",\n        \"object-statistics\",\n        \"object-tracking\",\n        \"privacy-masking\",\n        \"roi-mapping\",\n        \"single-video-event-analysis\",\n        \"video-embedding-index\",\n        \"video-object-analytics\",\n        \"video-search\",\n        \"video-segment-extraction\",\n        \"video-stream-ingestion\"\n      ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/frame-sampling\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/frame-sampling/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/frame-sampling/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/frame-sampling\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"32f70502-49f3-4bc3-8a9a-b84d6a4ea096","tool_call_id":"call_f00543183e2c48b2baefaa13","artifact":null,"status":"success"},{"content":"让我先提取更多不同时间点的视频帧，然后进行目标检测：\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":354,"prompt_tokens":20571,"total_tokens":20925,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":140,"rejected_prediction_tokens":null,"text_tokens":354},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":20571}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-effaaaf0-243e-9cd0-bc18-5c3466e94e3b","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e6d-84cc-73d3-a7b7-d1a2e86c9a68-0","tool_calls":[{"name":"bash","args":{"command":"cd /mnt/user-data/workspace && python -c \"\nimport cv2\ncap = cv2.VideoCapture('/mnt/user-data/uploads/Trafic-30s.mp4')\nfps = cap.get(cv2.CAP_PROP_FPS)\ntotal_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\nwidth = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\nheight = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\nduration = total_frames / fps if fps > 0 else 0\nprint(f'FPS: {fps}, Total frames: {total_frames}, Resolution: {width}x{height}, Duration: {duration:.1f}s')\ncap.release()\n\"\n","description":"检查视频基本信息（分辨率、帧率、时长）"},"id":"call_dcef9cf758f348e2a54085af","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":20571,"output_tokens":354,"total_tokens":20925,"input_token_details":{},"output_token_details":{"reasoning":140}}},{"content":"FPS: 12.0, Total frames: 360, Resolution: 1280x674, Duration: 30.0s","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"bash","id":"29e4d9bc-d9da-447e-98a0-ca00fa517f66","tool_call_id":"call_dcef9cf758f348e2a54085af","artifact":null,"status":"success"},{"content":"视频是 1280x674 分辨率、30秒时长。我来提取全片多帧并进行打码处理：\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":677,"prompt_tokens":20834,"total_tokens":21511,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":243,"rejected_prediction_tokens":null,"text_tokens":677},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":20834}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-1070b245-1d41-9236-a167-163fe3f885b7","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e6d-995d-7530-a673-cf4b1864c9c7-0","tool_calls":[{"name":"bash","args":{"command":"cd /mnt/user-data/workspace && python -c \"\nimport cv2\nimport json\n\ncap = cv2.VideoCapture('/mnt/user-data/uploads/Trafic-30s.mp4')\nfps = cap.get(cv2.CAP_PROP_FPS)\ntotal_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n\n# Extract frames every 3 seconds (frames at 0s, 3s, 6s, ..., 27s = 10 frames)\nframe_interval = int(fps * 3)  # 36 frames apart\noutput_dir = '/mnt/user-data/workspace/extracted_frames'\n\nimport os\nos.makedirs(output_dir, exist_ok=True)\n\nframe_ids = []\nfor i in range(0, total_frames, frame_interval):\n    cap.set(cv2.CAP_PROP_POS_FRAMES, i)\n    ret, frame = cap.read()\n    if ret:\n        fname = f'frame_{i//int(fps):03d}.jpg'\n        fpath = os.path.join(output_dir, fname)\n        cv2.imwrite(fpath, frame)\n        frame_ids.append({'frame_index': i, 'timestamp_s': i/int(fps), 'filename': fname, 'filepath': fpath})\n        print(f'Extracted: {fname} at {i/int(fps):.1f}s')\n\ncap.release()\n\n# Save frame index\nwith open(os.path.join(output_dir, 'frame_index.json'), 'w') as f:\n    json.dump(frame_ids, f, indent=2)\nprint(f'Total extracted: {len(frame_ids)} frames')\n\"\n","description":"从视频中均匀提取10帧（每3秒一帧）"},"id":"call_3ad64c9f95d64b2ab0794473","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":20834,"output_tokens":677,"total_tokens":21511,"input_token_details":{},"output_token_details":{"reasoning":243}}},{"content":"cd /mnt/user-data/workspace && python -c \"\nimport cv2\nimport json\ncap = cv2.VideoCapture('/mnt/user-data/uploads/Trafic-30s.mp4')\nfps = cap.get(cv2.CAP_PROP_FPS)\ntotal_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n# Extract frames every 3 seconds (frames at 0s, 3s, 6s, ..., 27s = 10 frames)\nframe_interval = int(fps * 3)  # 36 frames apart\noutput_dir = '/mnt/user-data/workspace/extracted_frames'\nimport os\nos.makedirs(output_dir, exist_ok=True)\nframe_ids = []\nfor i in range(0, total_frames, frame_interval):\n    cap.set(cv2.CAP_PROP_POS_FRAMES, i)\n    ret, frame = cap.read()\n    if ret:\n        fname = f'frame_{i//int(fps):03d}.jpg'\n        fpath = os.path.join(output_dir, fname)\n        cv2.imwrite(fpath, frame)\n        frame_ids.append({'frame_index': i, 'timestamp_s': i/int(fps), 'filename': fname, 'filepath': fpath})\n        print(f'Extracted: {fname} at {i/int(fps):.1f}s')\ncap.release()\n# Save frame index\nwith open(os.path.join(output_dir, 'frame_index.json'), 'w') as f:\n    json.dump(frame_ids, f, indent=2)\nprint(f'Total extracted: {len(frame_ids)} frames')\n\"\nExtracted: frame_000.jpg at 0.0s\nExtracted: frame_003.jpg at 3.0s\nExtracted: frame_006.jpg at 6.0s\nExtracted: frame_009.jpg at 9.0s\nExtracted: frame_012.jpg at 12.0s\nExtracted: frame_015.jpg at 15.0s\nExtracted: frame_018.jpg at 18.0s\nExtracted: frame_021.jpg at 21.0s\nExtracted: frame_024.jpg at 24.0s\nExtracted: frame_027.jpg at 27.0s\nTotal extracted: 10 frames","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"bash","id":"26b21303-d5f7-4af4-a08a-268192506684","tool_call_id":"call_3ad64c9f95d64b2ab0794473","artifact":null,"status":"success"},{"content":"好的，已提取10帧。现在我对每帧进行人脸和车牌检测并打码。\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":1935,"prompt_tokens":21804,"total_tokens":23739,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":466,"rejected_prediction_tokens":null,"text_tokens":1935},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":21804}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-d7165de5-ece6-9046-8514-c71979d49b6e","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e6d-bd20-7681-8f93-0b518f7a165e-0","tool_calls":[{"name":"bash","args":{"command":"cd /mnt/user-data/workspace && python -c \"\nimport cv2\nimport numpy as np\nimport json\nimport os\n\n# Load pre-trained cascades\nface_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')\nif face_cascade.empty():\n    print('WARNING: Haar cascade not found, will try alternative methods')\n\n# License plate detection helper - using color-based approach for Chinese plates\ndef detect_license_plates(frame):\n    \\\"\\\"\\\"Detect license plate regions in vehicles using color and shape heuristics.\\\"\\\"\\\"\n    h, w = frame.shape[:2]\n    plates = []\n    \n    # Convert to HSV for color detection\n    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)\n    \n    # Define ranges for Chinese license plate colors\n    # Blue plates (standard): hue ~110-130\n    blue_lower = np.array([100, 50, 50])\n    blue_upper = np.array([130, 255, 255])\n    # Yellow plates (large vehicles): hue ~25-35\n    yellow_lower = np.array([20, 100, 100])\n    yellow_upper = np.array([35, 255, 255])\n    \n    masks = [cv2.inRange(hsv, blue_lower, blue_upper),\n             cv2.inRange(hsv, yellow_lower, yellow_upper)]\n    \n    for mask in masks:\n        # Morphological operations to clean noise\n        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))\n        dilated = cv2.dilate(mask, kernel, iterations=3)\n        eroded = cv2.erode(dilated, kernel, iterations=2)\n        \n        contours, _ = cv2.findContours(eroded, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n        \n        for cnt in contours:\n            area = cv2.contourArea(cnt)\n            x, y, cw, ch = cv2.boundingRect(cnt)\n            \n            # Filter by size - license plates are typically 5-15% of frame width\n            if area > 1000 and cw > 40 and ch > 15 and cw < w * 0.3:\n                aspect_ratio = cw / float(ch)\n                # Chinese plates have aspect ratio ~3-5\n                if 2.5 < aspect_ratio < 6.0:\n                    plates.append((x, y, x + cw, y + ch))\n    \n    return plates\n\ndef detect_faces(frame):\n    \\\"\\\"\\\"Detect faces using Haar Cascade.\\\"\\\"\\\"\n    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n    faces = face_cascade.detectMultiScale(\n        gray, scaleFactor=1.1, minNeighbors=5, minSize=(20, 20)\n    )\n    result = []\n    for (x, y, fw, fh) in faces:\n        result.append((x, y, x + fw, y + fh))\n    return result\n\ndef apply_gaussian_blur(image, x1, y1, x2, y2, radius=31):\n    \\\"\\\"\\\"Apply Gaussian blur to a region.\\\"\\\"\\\"\n    roi = image[y1:y2, x1:x2]\n    blurred = cv2.GaussianBlur(roi, (radius, radius), 0)\n    image[y1:y2, x1:x2] = blurred\n    return image\n\ndef process_frame(filepath):\n    \\\"\\\"\\\"Process a single frame: detect faces and plates, then mask.\\\"\\\"\\\"\n    img = cv2.imread(filepath)\n    if img is None:\n        return None\n    \n    img_copy = img.copy()\n    sensitive_regions = []\n    \n    # Detect faces\n    faces = detect_faces(img)\n    for face in faces:\n        x1, y1, x2, y2 = face\n        img_copy = apply_gaussian_blur(img_copy, x1, y1, x2, y2, radius=31)\n        sensitive_regions.append({'type': 'face', 'bbox': [x1, y1, x2, y2], 'count': 1})\n    \n    # Detect license plates\n    plates = detect_license_plates(img)\n    for plate in plates:\n        x1, y1, x2, y2 = plate\n        img_copy = apply_gaussian_blur(img_copy, x1, y1, x2, y2, radius=31)\n        sensitive_regions.append({'type': 'license_plate', 'bbox': [x1, y1, x2, y2], 'count': 1})\n    \n    return img_copy, sensitive_regions\n\n# Process all frames\noutput_dir = '/mnt/user-data/workspace/masked_frames'\nos.makedirs(output_dir, exist_ok=True)\ninput_dir = '/mnt/user-data/workspace/extracted_frames'\n\nresults = []\nfor fname in sorted(os.listdir(input_dir)):\n    if not fname.endswith('.jpg'):\n        continue\n    fpath = os.path.join(input_dir, fname)\n    masked_img, regions = process_frame(fpath)\n    \n    if masked_img is not None:\n        out_path = os.path.join(output_dir, fname)\n        cv2.imwrite(out_path, masked_img)\n        results.append({\n            'filename': fname,\n            'faces_detected': sum(1 for r in regions if r['type'] == 'face'),\n            'plates_detected': sum(1 for r in regions if r['type'] == 'license_plate'),\n            'total_sensitive': len(regions),\n            'regions': regions,\n            'output_path': out_path\n        })\n        print(f'{fname}: {len(regions)} regions masked ({sum(1 for r in regions if r[\\\"type\\\"]==\\\"face\\\")} faces, {sum(1 for r in regions if r[\\\"type\\\"]==\\\"license_plate\\\")} plates)')\n\n# Save results manifest\nwith open('/mnt/user-data/workspace/masked_results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(f'\\\\nTotal frames processed: {len(results)}')\n\"\n","description":"对提取的10帧逐帧进行人脸和车牌检测与高斯模糊打码"},"id":"call_75b132b1a3414b96885e8e87","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":21804,"output_tokens":1935,"total_tokens":23739,"input_token_details":{},"output_token_details":{"reasoning":466}}},{"content":"cd /mnt/user-data/workspace && python -c \"\nimport cv2\nimport numpy as np\nimport json\nimport os\n# Load pre-trained cascades\nface_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')\nif face_cascade.empty():\n    print('WARNING: Haar cascade not found, will try alternative methods')\ng# License plate detection helper - using color-based approach for Chinese plates\ndef detect_license_plates(frame):\n    \\\"\\\"\\\"Detect license plate regions in vehicles using color and shape heuristics.\\\"\\\"\\\"\n    h, w = frame.shape[:2]\n    plates = []\n\n    # Convert to HSV for color detection\n    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)\n\n\n    # Define ranges for Chinese license plate colors\n    # Blue plates (standard): hue ~110-130\n    blue_lower = np.array([100, 50, 50])\n    blue_upper = np.array([130, 255, 255])\n    # Yellow plates (large vehicles): hue ~25-35\n    yellow_lower = np.array([20, 100, 100])\n    yellow_upper = np.array([35, 255, 255])\n\n    masks = [cv2.inRange(hsv, blue_lower, blue_upper),\n             cv2.inRange(hsv, yellow_lower, yellow_upper)]\n\n    for mask in masks:\n        # Morphological operations to clean noise\n        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))\n        dilated = cv2.dilate(mask, kernel, iterations=3)\n        eroded = cv2.erode(dilated, kernel, iterations=2)\n\n        contours, _ = cv2.findContours(eroded, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n\n        for cnt in contours:\n            area = cv2.contourArea(cnt)\n            x, y, cw, ch = cv2.boundingRect(cnt)\n\n            # Filter by size - license plates are typically 5-15% of frame width\n            if area > 1000 and cw > 40 and ch > 15 and cw < w * 0.3:\n                aspect_ratio = cw / float(ch)\n                # Chinese plates have aspect ratio ~3-5\n                if 2.5 < aspect_ratio < 6.0:\n                    plates.append((x, y, x + cw, y + ch))\n\n    return plates\ndef detect_faces(frame):\n    \\\"\\\"\\\"Detect faces using Haar Cascade.\\\"\\\"\\\"\n    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n    faces = face_cascade.detectMultiScale(\n        gray, scaleFactor=1.1, minNeighbors=5, minSize=(20, 20)\n    )\n    result = []\n    for (x, y, fw, fh) in faces:\n        result.append((x, y, x + fw, y + fh))\n    return result\ndef apply_gaussian_blur(image, x1, y1, x2, y2, radius=31):\n    \\\"\\\"\\\"Apply Gaussian blur to a region.\\\"\\\"\\\"\n    roi = image[y1:y2, x1:x2]\n    blurred = cv2.GaussianBlur(roi, (radius, radius), 0)\n    image[y1:y2, x1:x2] = blurred\n    return image\ndef process_frame(filepath):\n    \\\"\\\"\\\"Process a single frame: detect faces and plates, then mask.\\\"\\\"\\\"\n    img = cv2.imread(filepath)\n    if img is None:\n        return None\n\n    img_copy = img.copy()\n    sensitive_regions = []\n\n    # Detect faces\n    faces = detect_faces(img)\n    for face in faces:\n        x1, y1, x2, y2 = face\n        img_copy = apply_gaussian_blur(img_copy, x1, y1, x2, y2, radius=31)\n        sensitive_regions.append({'type': 'face', 'bbox': [x1, y1, x2, y2], 'count': 1})\n\n    # Detect license plates\n    plates = detect_license_plates(img)\n    for plate in plates:\n        x1, y1, x2, y2 = plate\n        img_copy = apply_gaussian_blur(img_copy, x1, y1, x2, y2, radius=31)\n        sensitive_regions.append({'type': 'license_plate', 'bbox': [x1, y1, x2, y2], 'count': 1})\n\n    return img_copy, sensitive_regions\n# Process all frames\noutput_dir = '/mnt/user-data/workspace/masked_frames'\nos.makedirs(output_dir, exist_ok=True)\ninput_dir = '/mnt/user-data/workspace/extracted_frames'\nresults = []\nfor fname in sorted(os.listdir(input_dir)):\n    if not fname.endswith('.jpg'):\n        continue\n    fpath = os.path.join(input_dir, fname)\n    masked_img, regions = process_frame(fpath)\n\n    if masked_img is not None:\n        out_path = os.path.join(output_dir, fname)\n        cv2.imwrite(out_path, masked_img)\n        results.append({\n            'filename': fname,\n            'faces_detected': sum(1 for r in regions if r['type'] == 'face'),\n            'plates_detected': sum(1 for r in regions if r['type'] == 'license_plate'),\n            'total_sensitive': len(regions),\n            'regions': regions,\n            'output_path': out_path\n        })\n      