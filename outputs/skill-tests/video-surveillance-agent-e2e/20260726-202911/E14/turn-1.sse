  \"label\": \"car\",\n            \"confidence\": 0.8154,\n            \"bbox\": [\n              468.18,\n              227.26,\n              531.07,\n              280.53\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_002\",\n            \"label\": \"bus\",\n            \"confidence\": 0.8029,\n            \"bbox\": [\n              575.34,\n              139.15,\n              643.61,\n              236.98\n            ],\n            \"model_label\": \"bus\"\n          },\n          {\n            \"object_id\": \"det_0003_003\",\n            \"label\": \"car\",\n            \"confidence\": 0.7531,\n            \"bbox\": [\n              425.12,\n              350.8,\n              519.45,\n              442.67\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_004\",\n            \"label\": \"car\",\n            \"confidence\": 0.6144,\n            \"bbox\": [\n              23.05,\n              197.94,\n              90.95,\n              241.24\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_005\",\n            \"label\": \"car\",\n            \"confidence\": 0.5729,\n            \"bbox\": [\n              94.1,\n              197.61,\n              171.36,\n              251.35\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_006\",\n            \"label\": \"car\",\n            \"confidence\": 0.5511,\n            \"bbox\": [\n              642.22,\n              147.27,\n              678.12,\n              172.35\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_007\",\n            \"label\": \"car\",\n            \"confidence\": 0.5049,\n            \"bbox\": [\n              94.08,\n              209.6,