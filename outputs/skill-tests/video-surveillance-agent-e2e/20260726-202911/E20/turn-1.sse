n# 加载CLIP模型进行视觉特征提取\nprint('Loading CLIP model...')\nmodel = SentenceTransformer('clip-ViT-B-32')\n\n# 读取所有关键帧并提取特征\nkf_dir = '/mnt/user-data/workspace/video-index/keyframes'\nkfs = sorted([f for f in os.listdir(kf_dir) if f.endswith('.jpg')])\n\nprint(f'Processing {len(kfs)} keyframes...')\nfeatures = []\nframe_meta = []\n\nfor i, kf in enumerate(kfs):\n    path = os.path.join(kf_dir, kf)\n    img = Image.open(path).convert('RGB')\n    \n    # 提取视觉特征\n    feat = model.encode([img], batch_size=1, show_progress_bar=False, normalize_embeddings=True)\n    features.append(feat[0])\n    \n    frame_meta.append({\n        'frame_id': i + 1,\n        'filename': kf,\n        'timestamp_s': i * 3,\n        'file_size_bytes': os.path.getsize(path)\n    })\n    \n    print(f'  Frame {i+1}/{len(kfs)}: {kf} -> shape={feat.shape}')\n\n# 转为numpy数组\nfeatures_np = np.array(features)\nprint(f'Total features: {features_np.shape}')\nprint(f'Feature dimension: {features_np.shape[1]}')\n\n# 保存特征\nnp.save('/mnt/user-data/workspace/video-index/features.npy', features_np)\n\n# 保存元数据\nmetadata = {\n    'video_path': '/mnt/user-data/uploads/Trafic-30s.mp4',\n    'video_filename': 'Trafic-30s.mp4',\n    'video_size_bytes': os.path.getsize('/mnt/user-data/uploads/Trafic-30s.mp4'),\n    'resolution': '1280x674',\n    'fps': 12.0,\n    'duration_seconds': 30.0,\n    'total_frames': 360,\n    'keyframes_extracted': len(kfs),\n    'feature_dimension': int(features_np.shape[1]),\n    'embedding_model': 'clip-ViT-B-32',\n    'frame_metadata': frame_meta\n}\n\nwith open('/mnt/user-data/workspace/video-index/metadata.json', 'w') as f:\n    json.dump(metadata, f, indent=2, ensure_ascii=False)\n\nprint('\\\\nFeatures saved successfully!')\nprint(f'Metadata saved to: /mnt/user-data/workspace/video-index/metadata.json')\n\"\n","description":"使用CLIP模型提取关键帧视觉语义特征并保存"},"id":"call_b3e86aa6c7494ec9b16af89e","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":14582,"output_tokens":733,"total_tokens":15315,"input_token_details":{},"output_token_details":{"reasoning":59}}},{"content":"python -c \"\nimport os, json, numpy as np\nfrom PIL import Image\nfrom sentence_transformers import SentenceTransformer\n# 创建输出目录\nos.makedirs('/mnt/user-data/workspace/video-index', exist_ok=True)\n# 加载CLIP模型进行视觉特征提取\nprint('Loading CLIP model...')\nmodel = SentenceTransformer('clip-ViT-B-32')\n# 读取所有关键帧并提取特征\nkf_dir = '/mnt/user-data/workspace/video-index/keyframes'\n\nkfs = sorted([f for f in os.listdir(kf_dir) if f.endswith('.jpg')])\nprint(f'Processing {len(kfs)} keyframes...')\nfeatures = []\nframe_meta = []\nfor i, kf in enumerate(kfs):\n    path = os.path.join(kf_dir, kf)\n    img = Image.open(path).convert('RGB')\n\n    # 提取视觉特征\n    feat = model.encode([img], batch_size=1, show_progress_bar=False, normalize_embeddings=True)\n    features.append(feat[0])\n\n    frame_meta.append({\n        'frame_id': i + 1,\n        'filename': kf,\n        'timestamp_s': i * 3,\n        'file_size_bytes': os.path.getsize(path)\n    })\n\n    print(f'  Frame {i+1}/{len(kfs)}: {kf} -> shape={feat.shape}')\n# 转为numpy数组\nfeatures_np = np.array(features)\nprint(f'Total features: {features_np.shape}')\nprint(f'Feature dimension: {features_np.shape[1]}')\n# 保存特征\nnp.save('/mnt/user-data/workspace/video-index/features.npy', features_np)\n# 保存元数据\nmetadata = {\n    'video_path': '/mnt/user-data/uploads/Trafic-30s.mp4',\n    'video_filename': 'Trafic-30s.mp4',\n    'video_size_bytes': os.path.getsize('/mnt/user-data/uploads/Trafic-30s.mp4'),\n    'resolution': '1280x674',\n    'fps': 12.0,\n    'duration_seconds': 30.0,\n    'total_frames': 360,\n    'keyframes_extracted': len(kfs),\n    'feature_dimension': int(features_np.shape[1]),\n    'embedding_model': 'clip-ViT-B-32',\n    'frame_metadata': frame_meta\n}\nwith open('/mnt/user-data/workspace/video-index/metadata.json', 'w') as f:\n    json.dump(metadata, f, indent=2, ensure_ascii=False)\nprint('\\\\nFeatures saved successfully