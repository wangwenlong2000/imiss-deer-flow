nprint()\nprint(f'📋 资产编号:     {reg[\\\"asset_id\\\"]}')\nprint(f'🎬 资产标题:     {reg[\\\"title\\\"]}')\nprint(f'📝 资产描述:     {reg[\\\"description\\\"]}')\nprint(f'🕐 登记时间:     {reg[\\\"registered_at\\\"]}')\nprint()\nprint('-' * 70)\nprint('📦 原始文件信息')\nprint('-' * 70)\nprint(f'  文件名:       {reg[\\\"original_filename\\\"]}')\nprint(f'  存储路径:     {reg[\\\"storage_path\\\"]}')\nprint(f'  文件大小:     {reg[\\\"file_size_bytes\\\"] / 1024:.1f} KB')\nprint(f'  MD5校验值:    {reg[\\\"file_hash_md5\\\"]}')\nprint()\nprint('-' * 70)\nprint('🎥 视频属性')\nprint('-' * 70)\nvp = reg['video_properties']\nprint(f'  分辨率:       {vp[\\\"resolution\\\"]}')\nprint(f'  帧率:         {vp[\\\"fps\\\"]} fps')\nprint(f'  时长:         {vp[\\\"duration_seconds\\\"]} 秒')\nprint(f'  总帧数:       {vp[\\\"total_frames\\\"]} 帧')\nprint(f'  编码格式:     {vp[\\\"codec\\\"]}')\nprint()\nprint('-' * 70)\nprint('🔍 对象检测结果 (YOLOv8n)')\nprint('-' * 70)\nod = reg['object_detection_summary']\nprint(f'  公交车:       {od[\\\"bus\\\"]} 辆')\nprint(f'  小轿车:       {od[\\\"car\\\"]} 辆')\nprint(f'  检测总数:     {od[\\\"total_detections\\\"]} 次')\nprint(f'  分析帧数:     {od[\\\"frames_analyzed\\\"]} 帧')\nprint()\nprint('-' * 70)\nprint('🧠 语义向量化配置')\nprint('-' * 70)\npi = reg['processing_info']\nprint(f'  提取关键帧:   {pi[\\\"keyframes_extracted\\\"]} 帧 (每{pi[\\\"keyframe_interval_s\\\"]}秒)')\nprint(f'  Embedding模型: {pi[\\\"embedding_model\\\"]}')\nprint(f'  特征维度:     {pi[\\\"feature_dimension\\\"]}')\nprint(f'  索引类型:     {pi[\\\"index_type\\\"]}')\nprint(f'  距离度量:     L2 (欧几里得距离)')\nprint()\nprint('-' * 70)\nprint('🏷️ 语义标签')\nprint('-' * 70)\nprint(f'  {\\\", \\\".join(reg[\\\"semantic_tags\\\"])}')\nprint()\nprint('-' * 70)\nprint('💾 索引文件位置')\nprint('-' * 70)\nprint(f'  向量索引:     {pi[\\\"index_file\\\"]}')\nprint(f'  特征数据:     {pi[\\\"features_file\\\"]}')\nprint(f'  登记记录:     /mnt/user-data/outputs/video_registration.json')\nprint(f'  索引配置:     /mnt/user-data/outputs/index_configuration.json')\nprint()\nprint('=' * 70)\nprint('✅ 入库状态: 已完成 | 索引状态: 已就绪')\nprint('=' * 70)\n\"\n","description":"生成完整的入库登记状态报告"},"id":"call_25c0454ebe424802a17924db","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":21970,"output_tokens":980,"total_tokens":22950,"input_token_details":{},"output_token_details":{"reasoning":18}}}],"uploaded_files":[{"filename":"Trafic-30s.mp4","size":1533354,"path":"/mnt/user-data/uploads/Trafic-30s.mp4","extension":".mp4"}],"viewed_images":{},"intent_context":{"intent":"task","original_query":"把我上传的这个视频登记入库，并建立可以语义搜索的向量索引。","normalized_query":"把我上传的这个视频登记入库，并建立可以语义搜索的向量索引。","routing_query":"场景：表格年鉴。场景ID：table_yearbook。场景说明：统计年鉴、政府公报表格、统计报表、规则数据表、带网格和表头的表格图片或已转换的 table.json/semantic.json 表格数据解析场景。适用于从表格图片或复杂表格中精确定位行列单元格、提取切片、计算占比/合计/同比/排名，并基于 local-table-ocr skill 生成原始表格 JSON、语义增强 JSON、带行列索引的增强图，再通过 get_cell/get_slice 精确取值。。需要识别参数：表格对象、定位依据、计算指标、输出形式。用户原始问题：我将把上传的视频登记入库，并建立支持语义搜索的向量索引","scene":"table_yearbook","scene_name":"表格年鉴","params":{"表格对象":"","定位依据":"","计算指标":"","输出形式":""},"scene_mode":"single","scenes":["table_yearbook"],"task_spans":[{"task_span_id":"span_394206","text":"把我上传的这个视频登记入库，并建立可以语义搜索的向量索引。"}],"planning_steps":[{"task_span_id":"span_134e95","text":"读取用户上传的视频文件，解析其基础元数据（格式、时长、分辨率），并按固定时间间隔抽取关键帧或调用语音转写服务提取音视频文本内容，形成结构化预处理样本集。"},{"task_span_id":"span_a0ca01","text":"基于多模态特征提取模型对预处理样本集进行向量化编码，明确向量维度与相似度计算口径，生成标准化的语义特征数据集。"},{"task_span_id":"span_6f5a50","text":"配置向量检索引擎参数（含索引算法类型、树深/邻居数设置及距离度量方式），将特征数据集写入存储并完成索引构建，验证检索延迟与召回率指标。"},{"task_span_id":"span_ff4185","text":"在目标资产库中创建视频登记记录，绑定视频唯一标识、物理存储路径、索引版本信息及特征数据映射关系，完成入库注册与元数据固化。"},{"task_span_id":"span_e74dd7","text":"核对索引构建完整度与登记字段准确性，输出包含资产ID、索引配置清单、入库状态报告及后续语义检索操作指引的结构化交付物。"}],"scene_tasks":[{"sub_task_id":"sub_ce5f86","scene":"table_yearbook","scene_name":"表格年鉴","text":"我将把上传的视频登记入库，并建立支持语义搜索的向量索引。","params":{}}],"sub_tasks":[{"sub_task_id":"sub_ce5f86","scene":"table_yearbook","scene_name":"表格年鉴","text":"我将把上传的视频登记入库，并建立支持语义搜索的向量索引。","params":{}}],"task_hints":["提取必填参数：表格对象。需要解析的统计年鉴截图、政府公报表格、报表图片、带表头和网格的