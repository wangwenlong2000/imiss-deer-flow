"}}],"sub_tasks":[{"sub_task_id":"sub_254999","scene":"video_surveillance","scene_name":"视频监控","text":"我将截取视频监控中第15秒前后各5秒的视频片段用于留证。","params":{"时间范围":"第 15 秒前后各 5 秒","输出形式":"视频片段"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:4dbbe458-6477-4570-8126-78faa38f3cf5"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic-30s.mp4 (1.5 MB)\n  Path: /mnt/user-data/uploads/Trafic-30s.mp4\n\nYou can read these files using the `read_file` tool with the paths shown above.\n</uploaded_files>\n\n以第 15 秒为事件时间，截取前后各 5 秒的视频片段用于留证。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic-30s.mp4 (1.5 MB)\n  Path: /mnt/user-data/uploads/Trafic-30s.mp4\n\nYou can read these files using the `read_file` tool with the paths shown above.\n</uploaded_files>\n\n以第 15 秒为事件时间，截取前后各 5 秒的视频片段用于留证。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","vide