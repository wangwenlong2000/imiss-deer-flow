-stream-ingestion\"\n      ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/camera-health-check\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/camera-health-check/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/camera-health-check\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"075b888a-4498-475e-a3b8-e3f9117f65ce","tool_call_id":"call_be6ac68db4054f70bda55fa6","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":80,"prompt_tokens":14591,"total_tokens":14671,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":17,"rejected_prediction_tokens":null,"text_tokens":80},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":14591}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-ca32dccb-4c47-9869-bfd8-271717c52d06","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e32-7ee6-7963-b7a8-668275563992-0","tool_calls":[{"name":"read_file","args":{"description":"读取摄像头健康检查技能的工作流程说明","path":"/mnt/skills/custom/video_surveillance/camera-health-check/SKILL.md"},"id":"call_1ad231cbe2a4461b901b440d","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":14591,"output_tokens":80,"total_tokens":14671,"input_token_details":{},"output_token_details":{"reasoning":17}}},{"content":"---\nname: camera-health-check\ndescription: Check video monitoring camera quality from sampled frames and return health status before downstream event generation. Use when Codex has camera_id and frames and needs to gate or downgrade event confidence for offline, unavailable, degraded, black-screen, blurred, occluded, frozen, corrupted, or shifted camera feeds.\n---\n\n# Camera Health Check\n\n## Execution Priority\n\nFor business requests about a camera ID or camera health without frames already provided, load `city-video-intelligence` first and run its router script before this atomic skill. This skill is the downstream health checker after a video source or sampled frames are known.\n\nPrioritize calling this skill's `scripts/run.py` entrypoint first. Only write custom code after the script result is unsuitable or the script cannot cover the requested task.\n\n## Input Resolution\n\nIf `frames` are missing but the user provided a video source, do not ask the user to provide frames and do not write custom camera diagnostics. First call `frame-sampling/scripts/run.py` to generate frames, then call this skill.\n\n\n## Atomic CLI\n\nRun this skill directly with its own script. The script does not call other skill scripts and does not depend on shared `src`, `tools`, or registry modules.\n\n```bash\npython camera-health-check/scripts/run.py --frames-json <frames.json> --camera-id <camera_id> --config <config.json> --output <health.json>\n```\n\nParameters: `--frames-json`, `--camera-id`, `--health-status`, `--config`, `--output`.\n\n## Workflow\n\n1. Read camera id and sampled frames.\n2. Check frame availability and configured/manual health overrides.\n3. Compute or accept quality signals for black screen, blur, occlusion, freeze, corruption, and view shift.\n4. Return health status, health score, and issue reasons.\n\n## Available Implementation\n\nThis skill is implemented as an atomic standalone script in its own `scripts/run.py`. The script contains the executable logic for this skill and must not import shared `src`, `tools`, or registry modules.\n\n## Inputs\n\n- `camera_id`\n- `frames`\n- Optional `health_status` override\n- Optional `context.config[\"camera_health\"][camera_id]` override\n\n## Outputs\n\nReturns `health_status`, `health_score`, and `issues`.\n\n## Failure Modes\n\nThe current implementation returns success with `health_status=\"unavailable\"` when no frames are available.\n\n## Constraints\n\nDo not create events or evidence. Low quality should reduce downstream confidence or trigger review.\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"af367844-383c-43cb-b43a-2dc1945a9216","tool_call_id":"call_1ad231cbe2a4461b901b440d","artifact":null,"status":"success"},{"content":"技能说明要求我先从视频中提取帧，再执行健康检查。让我先加载帧采样技能。\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":177,"prompt_tokens":15199,"total_tokens":15376,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":64,"rejected_prediction_tokens":null,"text_tokens":177},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":15199}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-be3f4208-9439-9e90-9258-ed45b18ae2b2","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e32-86cc-7b21-b730-cae54cee3285-0","tool_calls":[{"name":"invoke_skill","args":{"skill_name":"frame-sampling","mode":"prepare","input_envelope":"{\"video_path\": \"/mnt/user-data/uploads/Trafic-30s.mp4\", \"camera_id\": \"CAM_Traffic_001\"}"},"id":"call_d6615788c2be4bf1a0cd9a0b","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":15199,"output_tokens":177,"total_tokens":15376,"input_token_details":{},"output_token_details":{"reasoning":64}}}],"artifacts":[],"intent_context":{"intent":"task","original_query":"这个摄像头的画面是不是有模糊、遮挡或者黑屏的问题？请给出健康状态和评分。","normalized_query":"这个摄像头的画面是不是有模糊、遮挡或者黑屏的问题？请给出健康状态和评分。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将检测这个摄像头的画面是否存在模糊、遮挡或黑屏问题，并输出健康状态和评分","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"这个摄像头","监控目标":"模糊、遮挡或者黑屏","输出形式":"健康状态和评分"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_d813e8","text":"这个摄像头的画面是不是有模糊、遮挡或者黑屏的问题？请给出健康状态和评分。"}],"planning_steps":[{"task_span_id":"span_b94eb8","text":"基于视频监控场景，首先读取并解析指定摄像头的最新视频流或关键帧数据，提取分辨率、有效像素分布及时间戳等基础参数，完成视频样本的结构化清洗与格式校验，输出标准化待检图像数据。"},{"task_span_id":"span_cd700d","text":"针对待检图像调用图像质量评估与缺陷识别能力，分别采用频域对比度分析检测画面模糊程度、利用空间分割算法计算遮挡区域占比、并通过全局亮度阈值判定是否存在黑屏现象，记录各项异常指标的量化数值与触发状态。"},{"task_span_id":"span_93ae6a","text":"将步骤二获取的缺陷量化结果输入安防巡检健康度评估模型，依据不同异常类型对监控有效性的影响权重进行加权计算，对照行业设备巡检分级标准判定健康等级，输出摄像头综合健康评分及对应状态分类。"},{"task_span_id":"span_f9aa5a","text":"整合缺陷检测明细、评分计算逻辑与健康状态结论，按照巡检交付规范生成结构化总结，明确呈现摄像头当前健康状态、具体得分、已识别问题项及后续维护建议，完成最终任务交付。"}],"scene_tasks":[{"sub_task_id":"sub_4b20dc","scene":"video_surveillance","scene_name":"视频监控","text":"我将检测这个摄像头的画面是否存在模糊、遮挡或黑屏问题，并输出健康状态和评分。","params":{"视频对象":"这个摄像头","监控目标":"模糊、遮挡或者黑屏","输出形式":"健康状态和评分"}}],"sub_tasks":[{"sub_task_id":"sub_4b20dc","scene":"video_surveillance","scene_name":"视频监控","text":"我将检测这个摄像头的画面是否存在模糊、遮挡或黑屏问题，并输出健康状态和评分。","params":{"视频对象":"这个摄像头","监控目标":"模糊、遮挡或者黑屏","输出形式":"健康状态和评分"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:e1c982de-3900-40d9-9ac8-a7bb0405c2d8"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic-30s.mp4 (1.5 MB)\n  Path: /mnt/user-data/uploads/Trafic-30s.mp4\n\nYou can read these files using the `read_file` tool with the paths shown above.\n</uploaded_files>\n\n这个摄像头的画面是不是有模糊、遮挡或者黑屏的问题？请给出健康状态和评分。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"<uploaded_files>\nThe following files were uploaded in this message:\n\n- Trafic-30s.mp4 (1.5 MB)\n  Path: /mnt/user-data/uploads/Trafic-30s.mp4\n\nYou can read these files using the `read_file` tool with the paths shown above.\n</uploaded_files>\n\n这个摄像头的画面是不是有模糊、遮挡或者黑屏的问题？请给出健康状态和评分。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:e1c982de-3900-40d9-9ac8-a7bb0405c2d8"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_ski