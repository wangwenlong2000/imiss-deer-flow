级序列、处置流转路径及溯源字段，生成标准化执行指引文档。预期产出：可落地的强制人工复核任务清单与操作手册。\\n场景任务：\\n- video_surveillance: 我将对事件置信度低、摄像头画面有遮挡或事件涉及执法的结果进行人工复核。\\n已提取参数：{'视频对象': '', '监控目标': '', '时间范围': '', '输出形式': ''}\\n任务提示：\\n- 提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧\\n- 提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等\\n- 提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口\\n- 提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要\\n</hidden_step>\\n</system_reminder>\"\n    },\n    \"inputs\": {\n      \"parameters\": {}\n    },\n    \"routing\": {\n      \"selected_skill\": \"human-review-routing\",\n      \"allowed_skills\": [\n        \"analyze-video\",\n        \"batch-video-ingestion\",\n        \"camera-health-check\",\n        \"city-video-intelligence\",\n        \"duplicate-event-merge\",\n        \"evidence-package-generation\",\n        \"evidence-snapshot\",\n        \"ffmpeg-utils\",\n        \"frame-sampling\",\n        \"human-review-routing\",\n        \"object-detection\",\n        \"object-statistics\",\n        \"object-tracking\",\n        \"privacy-masking\",\n        \"roi-mapping\",\n        \"single-video-event-analysis\",\n        \"video-embedding-index\",\n        \"video-object-analytics\",\n        \"video-search\",\n        \"video-segment-extraction\",\n        \"video-stream-ingestion\"\n      ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/human-review-routing\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/human-review-routing/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/human-review-routing\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"e96e6d94-77c2-4144-a4ee-4ea67b946d5e","tool_call_id":"call_e19d9a1a18bd496a895690c2","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":90,"prompt_tokens":14360,"total_tokens":14450,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":27,"rejected_prediction_tokens":null,"text_tokens":90},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":14360}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-d741c383-7866-992f-9978-ee6e0dc74f8e","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e23-8299-7dc1-8bf6-8f4d8460b111-0","tool_calls":[{"name":"read_file","args":{"description":"读取人工复核路由技能的工作流程文档","path":"/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md"},"id":"call_b996362cec4549fc8b681f3a","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":14360,"output_tokens":90,"total_tokens":14450,"input_token_details":{},"output_token_details":{"reasoning":27}}},{"content":"---\nname: human-review-routing\ndescription: Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.\n---\n\n# Human Review Routing\n\n## Execution Priority\n\nPrioritize calling this skill's `scripts/run.py` entrypoint first. Only write custom code after the script result is unsuitable or the script cannot cover the requested task.\n\n## Input Resolution\n\nIf event confidence or event fields are missing but the user provided a video analysis request, first call `single-video-event-analysis` to produce candidate events, then call this skill for review routing.\n\n\n## Atomic CLI\n\nRun this skill directly with its own script. The script does not call other skill scripts and does not depend on shared `src`, `tools`, or registry modules.\n\n```bash\npython human-review-routing/scripts/run.py --event-json <event.json> --camera-health-json <health.json> --config <config.json> --output <review.json>\n```\n\nParameters: `--event-json`, `--camera-health-json`, `--review-threshold`, `--config`, `--output`.\n\n## Workflow\n\n1. Read event confidence, event type, camera health, and review threshold.\n2. Require review for low confidence, high-risk types, degraded cameras, new cameras, or enforcement impact.\n3. Return review flag, reasons, threshold, and queue.\n\n## Available Implementation\n\nThis skill is implemented as an atomic standalone script in its own `scripts/run.py`. The script contains the executable logic for this skill and must not import shared `src`, `tools`, or registry modules.\n\n## Inputs\n\n- `event`\n- `camera_health`\n- Optional `review_threshold`\n\nConfig:\n- `default_review_threshold`\n- `review_thresholds.<event_type>`\n- `high_risk_event_types`\n\n## Outputs\n\nReturns `event_id`, `review_required`, `reasons`, `review_threshold`, and `queue`.\n\n## Failure Modes\n\nThe current implementation tolerates missing optional config and falls back to threshold `0.85`.\n\n## Constraints\n\nDo not merge duplicate events or generate evidence.\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"9aace99d-8820-4110-a183-f8309d7a205a","tool_call_id":"call_b996362cec4549fc8b681f3a","artifact":null,"status":"success"}],"artifacts":[],"intent_context":{"intent":"task","original_query":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","normalized_query":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将对事件置信度低、摄像头画面有遮挡或事件涉及执法的结果进行人工复核","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"","监控目标":"","时间范围":"","输出形式":""},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_7bf4f8","text":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？"}],"planning_steps":[{"task_span_id":"span_656511","text":"读取视频监控系统的事件配置表与算法日志，解析当前设定的置信度阈值参数、画面遮挡检测模块的触发逻辑及执法相关事件的自动标记规则，完成数据结构化提取。预期产出：系统触发条件清单与原始参数映射表。"},{"task_span_id":"span_c9a44d","text":"依托视频监控场景的目标检测与行为识别能力，按置信度低于基线、遮挡面积占比超限、事件标签含执法属性三项维度对告警数据进行过滤与归类，建立分类判定口径。预期产出：分维度的待复核事件特征矩阵。"},{"task_span_id":"span_6e0ca0","text":"检索安防巡检标准作业流程与执法证据留存规范，将分类结果与合规依据进行交叉比对，识别强制复核的边界条件与潜在漏判风险。预期产出：带依据索引的复核规则对照表及合规性校验报告。"},{"task_span_id":"span_41a08a","text":"整合校验后的规则清单与操作要求，编排人工复核任务的优先级序列、处置流转路径及溯源字段，生成标准化执行指引文档。预期产出：可落地的强制人工复核任务清单与操作手册。"}],"scene_tasks":[{"sub_task_id":"sub_fb264d","scene":"video_surveillance","scene_name":"视频监控","text":"我将对事件置信度低、摄像头画面有遮挡或事件涉及执法的结果进行人工复核。","params":{}}],"sub_tasks":[{"sub_task_id":"sub_fb264d","scene":"video_surveillance","scene_name":"视频监控","text":"我将对事件置信度低、摄像头画面有遮挡或事件涉及执法的结果进行人工复核。","params":{}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:f5fe0a5f-0350-4490-8dc7-7f251fb52854"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:f5fe0a5f-0350-4490-8dc7-7f251fb52854"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"allowed_tool_names":[]}

