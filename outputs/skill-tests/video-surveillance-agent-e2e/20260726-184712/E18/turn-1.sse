ction_tokens":null,"text_tokens":681},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":21083}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-29200e81-71d1-9858-9fe2-df3dd92fd441","finish_reason":"stop","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9e4f-5e6e-7a12-9ec8-529a56d1d62a-0","tool_calls":[],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":21083,"output_tokens":681,"total_tokens":21764,"input_token_details":{},"output_token_details":{"reasoning":411}}}],"artifacts":[],"intent_context":{"intent":"task","original_query":"找出摄像头 CAM_008 昨天 18 点到 20 点之间出现公交车的所有录像，并按时间排序。","normalized_query":"找出摄像头 cam 008 昨天 18 点到 20 点之间出现公交车的所有录像，并按时间排序。","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将检索摄像头CAM_008昨天18点到20点之间出现公交车的所有录像，并按时间排序","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"摄像头 CAM_008","监控目标":"公交车","时间范围":"昨天 18点到20点","输出形式":"按时间排序"},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_fc030a","text":"找出摄像头 CAM_008 昨天 18 点到 20 点之间出现公交车的所有录像，并按时间排序。"}],"planning_steps":[{"task_span_id":"span_eb0fd8","text":"调用视频存储系统接口，根据设备标识CAM_008与指定时间窗口（昨日18:00至20:00）拉取原始监控视频流或切片文件，解析基础元数据（分辨率、帧率、存储路径），产出结构化的原始视频数据索引清单。"},{"task_span_id":"span_9160d2","text":"在获取视频索引后，基于视频监控场景的AI分析能力对片段执行动态帧采样，输入车辆识别模型进行公交车特征匹配，设定置信度过滤门槛以剔除环境干扰，产出带时间戳与置信度评分的疑似公交车检测标记列表。"},{"task_span_id":"span_9dc3f3","text":"依据检测标记列表开展事件去重与逻辑合并，将相邻时间点的离散检测信号聚合成连续的公交车出现时段区间，并结合视频时间戳校验机制修正可能存在的跳帧偏差，产出时间轴对齐的去重事件清单。"},{"task_span_id":"span_12bd85","text":"将去重事件清单与后台过车日志或智能告警记录进行字段级交叉比对，核对车型分类、进出方向等辅助校验维度，执行抽样复核流程以确认识别口径的一致性，产出经交叉验证的合格录像事件集。"},{"task_span_id":"span_33167b","text":"按照公交车首次出现时间升序原则对合格事件集执行全量排序，提取对应录像片段的访问凭证或预览索引，封装为结构化检索结果表与可视化时间轴视图，并附加数据来源追溯标识完成最终交付准备。"}],"scene_tasks":[{"sub_task_id":"sub_fe843e","scene":"video_surveillance","scene_name":"视频监控","text":"我将检索摄像头CAM_008昨天18点到20点之间出现公交车的所有录像，并按时间排序。","params":{"视频对象":"摄像头 CAM_008","监控目标":"公交车","时间范围":"昨天 18点到20点","输出形式":"按时间排序"}}],"sub_tasks":[{"sub_task_id":"sub_fe843e","scene":"video_surveillance","scene_name":"视频监控","text":"我将检索摄像头CAM_008昨天18点到20点之间出现公交车的所有录像，并按时间排序。","params":{"视频对象":"摄像头 CAM_008","监控目标":"公交车","时间范围":"昨天 18点到20点","输出形式":"按时间排序"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:c0f64472-abba-4b81-9734-5b54e260468e"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"找出摄像头 CAM_008 昨天 18 点到 20 点之间出现公交车的所有录像，并按时间排序。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"找出摄像头 CAM_008 昨天 18 点到 20 点之间出现公交车的所有录像，并按时间排序。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"suppo