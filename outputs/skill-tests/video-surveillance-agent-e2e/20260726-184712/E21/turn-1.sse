内容检测）"}}],"task_hints":["提取必填参数：代码内容。用户提供的函数、类、脚本、源码文件或裸代码片段","提取可选参数：编程语言。代码片段所属语言，如 Python、Java、C++、JavaScript 等","提取可选参数：处理目标。用户希望执行的代码处理任务，如格式校验、AST 解析、标准化、语义意图识别、元数据标注、IO 提取、调用图、数据流、业务流程图、组件文档、示例生成或组件封装"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:f034cd2c-b002-4a4f-a6a8-3a1241b0fbbf"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"把 /mnt/datasets/Vedio-demo 这个目录里的视频批量登记到视频库，只登记元数据，不要做内容检测。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"把 /mnt/datasets/Vedio-demo 这个目录里的视频批量登记到视频库，只登记元数据，不要做内容检测。","scene":"program_snippet","input_refs":[],"task_types":[],"selected_skills":[{"id":"code-semantic-labeler","role":"primary","score":1.0,"reason":null},{"id":"code-splitter-adapter","role":"supporting","score":1.0,"reason":null},{"id":"code-to-ast-new","role":"supporting","score":1.0,"reason":null},{"id":"dataflow-extractor","role":"supporting","score":1.0,"reason":null},{"id":"opengrep-compliance","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["code-semantic-labeler","code-splitter-adapter","code-to-ast-new","dataflow-extractor","opengrep-compliance"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["code-semantic-labeler","code-splitter-adapter","code-to-ast-new","dataflow-extractor","opengrep-compliance"],"selection_owner":"lead_agent","_source_message_key":"id:f034cd2c-b002-4a4f-a6a8-3a1241b0fbbf"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["code-semantic-labeler","code-splitter-adapter","code-to-ast-new","dataflow-extractor","o