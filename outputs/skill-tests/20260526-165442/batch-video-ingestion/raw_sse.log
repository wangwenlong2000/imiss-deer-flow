o-ingestion/result.json\n{\n  \"skill\": \"batch-video-ingestion\",\n  \"version\": \"1.0.0\",\n  \"status\": \"failed\",\n  \"error_code\": \"ES_CONNECTION_FAILED\",\n  \"message\": \"Could not connect to Elasticsearch at http://host.docker.internal:3128: [Errno -2] Name or service not known\",\n  \"retryable\": true,\n  \"detail\": {\n    \"url\": \"http://host.docker.internal:3128\"\n  }\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"bash","id":"cc9b5631-d801-4660-8e11-b51c458aaea4","tool_call_id":"call_29d9a309956d48379da049b0","artifact":null,"status":"success"}],"thread_data":{"workspace_path":"/app/backend/.deer-flow/threads/b6b6b51d-341e-4339-8838-f9bf908c3d51/user-data/workspace","uploads_path":"/app/backend/.deer-flow/threads/b6b6b51d-341e-4339-8838-f9bf908c3d51/user-data/uploads","outputs_path":"/app/backend/.deer-flow/threads/b6b6b51d-341e-4339-8838-f9bf908c3d51/user-data/outputs"},"artifacts":[],"viewed_images":{}}

