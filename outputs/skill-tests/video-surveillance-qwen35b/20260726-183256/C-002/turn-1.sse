_patterns","predict_next_location","profile_urban_region","search_similar_trajectory","search_spatiotemporal"],"selection_owner":"lead_agent","_source_message_key":"id:5d06911a-4c72-4d06-ae25-4df85ba52571"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","extract_stay_points","forecast_region_flow","fuse_spatial_evidence","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","predict_next_location","profile_urban_region","search_similar_trajectory","search_spatiotemporal"],"allowed_tool_names":[]}

