D归类，剔除超出画面范围的异常框，确保分类标签与输入参数完全对应，输出清洗后的逐帧检测记录表。"},{"task_span_id":"span_51b0a2","text":"汇总所有帧的检测记录，按照“位置框、类别、置信度”的输出形式要求生成最终交付文件，校验输出结构与预期参数的一致性，完成视频监控场景下的目标检测任务规划闭环。"}],"scene_tasks":[{"sub_task_id":"sub_76b2e4","scene":"video_surveillance","scene_name":"视频监控","text":"我将检测测试视频/mnt/datasets/Vedio-demo/Trafic.mp4中的行人、轿车、公交车和卡车，并输出每帧的位置框、类别和置信度。","params":{"视频对象":"/mnt/datasets/Vedio-demo/Trafic.mp4","监控目标":"行人、轿车、公交车和卡车","输出形式":"每帧的位置框、类别和置信度"}}],"sub_tasks":[{"sub_task_id":"sub_76b2e4","scene":"video_surveillance","scene_name":"视频监控","text":"我将检测测试视频/mnt/datasets/Vedio-demo/Trafic.mp4中的行人、轿车、公交车和卡车，并输出每帧的位置框、类别和置信度。","params":{"视频对象":"/mnt/datasets/Vedio-demo/Trafic.mp4","监控目标":"行人、轿车、公交车和卡车","输出形式":"每帧的位置框、类别和置信度"}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:614ad988-6133-4e2f-8da0-a16c98e8a936"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"检测这段视频里的行人、轿车、公交车和卡车，输出每帧的位置框、类别和置信度。测试视频路径是 /mnt/datasets/Vedio-demo/Trafic.mp4。","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"检测这段视频里的行人、轿车、公交车和卡车，输出每帧的位置框、类别和置信度。测试视频路径是 /mnt/datasets/Vedio-demo/Trafic.mp4。","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","hum