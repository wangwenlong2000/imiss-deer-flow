_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","extract_stay_points","forecast_region_flow","fuse_spatial_evidence","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","predict_next_location","profile_urban_region","search_similar_trajectory","search_spatiotemporal"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","extract_stay_points","forecast_region_flow","fuse_spatial_evidence","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","predict_next_location","profile_urban_region","search_similar_trajectory","search_spatiotemporal"],"selection_owner":"lead_agent","_source_message_key":"id:2ab099eb-c7f4-4aa6-bb31-9b3a22edb210"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze_event_impact","analyze_od_flow","analyze_region_heat","analyze_spatiotemporal_accessibility","anonymize_trajectory_data","classify_trajectory_state","clean_trajectory","detect_flow_anomaly","detect_route_anomaly","detect_trajectory_cooccurrence","extract_stay_points","forecast_region_flow","fuse_spatial_evidence","map_spatial_grid","measure_spatiotemporal_entropy","mine_trajectory_patterns","predict_next_location","profile_urban_region","search_s