n        \"video-stream-ingestion\"\n      ],\n      \"selection_owner\": \"lead_agent\"\n    }\n  },\n  \"legacy_invocation\": {\n    \"skill_dir\": \"/app/skills/custom/video_surveillance/human-review-routing\",\n    \"skill_file\": \"/app/skills/custom/video_surveillance/human-review-routing/SKILL.md\",\n    \"container_skill_file\": \"/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md\",\n    \"selected_data_sources\": [],\n    \"argv\": [],\n    \"env\": {},\n    \"parameters\": {},\n    \"working_directory\": \"/app/skills/custom/video_surveillance/human-review-routing\",\n    \"adapter_note\": \"Load the returned container_skill_file, follow its SKILL.md workflow, and use selected_data_sources/parameters as the legacy inputs.\"\n  },\n  \"next_steps\": [\n    \"Read container_skill_file before executing the Skill workflow.\",\n    \"Use selected_data_sources and parameters as the legacy inputs.\",\n    \"After execution, call invoke_skill again with mode='wrap_output' to produce SkillResult.\"\n  ]\n}","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"invoke_skill","id":"eaf2484c-eaae-4b21-a3f9-1a4801a393bd","tool_call_id":"call_b7150d2ddac547beabb8eb00","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":94,"prompt_tokens":14419,"total_tokens":14513,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":26,"rejected_prediction_tokens":null,"text_tokens":94},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":14419}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-a2d52a8a-4021-9176-b2f7-5cc819b5ad5b","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9dd2-1967-7a32-9993-79b2dcb1330a-0","tool_calls":[{"name":"read_file","args":{"description":"读取人工复核路由技能文件，获取三类触发条件的判定规则","path":"/mnt/skills/custom/video_surveillance/human-review-routing/SKILL.md"},"id":"call_d52a9bce00fa4c66bf531baf","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":14419,"output_tokens":94,"total_tokens":14513,"input_token_details":{},"output_token_details":{"reasoning":26}}},{"content":"---\nname: human-review-routing\ndescription: Decide whether video monitoring event candidates require manual review. Use after event generation and evidence creation when Codex has event confidence, event_type, review_threshold, camera_health, high_risk_event_types, newly added camera signals, or enforcement-impact flags and needs review queue routing.\n---\n\n# Human Review Routing\n\n## Execution Priority\n\nPrioritize calling this skill's `scripts/run.py` entrypoint first. Only write custom code after the script result is unsuitable or the script cannot cover the requested task.\n\n## Input Resolution\n\nIf event confidence or event fields are missing but the user provided a video analysis request, first call `single-video-event-analysis` to produce candidate events, then call this skill for review routing.\n\n\n## Atomic CLI\n\nRun this skill directly with its own script. The script does not call other skill scripts and does not depend on shared `src`, `tools`, or registry modules.\n\n```bash\npython human-review-routing/scripts/run.py --event-json <event.json> --camera-health-json <health.json> --config <config.json> --output <review.json>\n```\n\nParameters: `--event-json`, `--camera-health-json`, `--review-threshold`, `--config`, `--output`.\n\n## Workflow\n\n1. Read event confidence, event type, camera health, and review threshold.\n2. Require review for low confidence, high-risk types, degraded cameras, new cameras, or enforcement impact.\n3. Return review flag, reasons, threshold, and queue.\n\n## Available Implementation\n\nThis skill is implemented as an atomic standalone script in its own `scripts/run.py`. The script contains the executable logic for this skill and must not import shared `src`, `tools`, or registry modules.\n\n## Inputs\n\n- `event`\n- `camera_health`\n- Optional `review_threshold`\n\nConfig:\n- `default_review_threshold`\n- `review_thresholds.<event_type>`\n- `high_risk_event_types`\n\n## Outputs\n\nReturns `event_id`, `review_required`, `reasons`, `review_threshold`, and `queue`.\n\n## Failure Modes\n\nThe current implementation tolerates missing optional config and falls back to threshold `0.85`.\n\n## Constraints\n\nDo not merge duplicate events or generate evidence.\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"e9acf09b-6ddd-44ad-9f97-b30b83b8e508","tool_call_id":"call_d52a9bce00fa4c66bf531baf","artifact":null,"status":"success"},{"content":"技能已加载。接下来查看实际的规则实现和配置文件，获取详细的判定阈值与条件。\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":199,"prompt_tokens":14976,"total_tokens":15175,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":119,"rejected_prediction_tokens":null,"text_tokens":199},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":14976}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-578e10a5-3065-9ad5-b68b-07aed9854910","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9dd2-355f-7b93-b281-c7831bf0fded-0","tool_calls":[{"name":"ls","args":{"description":"查看人工复核路由技能的脚本目录结构","path":"/mnt/skills/custom/video_surveillance/human-review-routing/scripts"},"id":"call_5332b4778ce44d4aa2d864b2","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":14976,"output_tokens":199,"total_tokens":15175,"input_token_details":{},"output_token_details":{"reasoning":119}}},{"content":"/mnt/skills/custom/video_surveillance/human-review-routing/scripts\n/mnt/skills/custom/video_surveillance/human-review-routing/scripts/run.py\n/mnt/skills/custom/video_surveillance/human-review-routing/scripts/__pycache__\n/mnt/skills/custom/video_surveillance/human-review-routing/scripts/__pycache__/run.cpython-310.pyc","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"ls","id":"a716c3d5-b3ec-43f7-a615-1437358b708b","tool_call_id":"call_5332b4778ce44d4aa2d864b2","artifact":null,"status":"success"},{"content":"","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":89,"prompt_tokens":15143,"total_tokens":15232,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":18,"rejected_prediction_tokens":null,"text_tokens":89},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":15143}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-9628f722-8142-9a59-8829-841a3ca1ec83","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9dd2-458a-7d31-987c-4ffa7abe3469-0","tool_calls":[{"name":"read_file","args":{"description":"读取人工复核路由脚本，获取置信度、遮挡、执法三类条件的判定逻辑","path":"/mnt/skills/custom/video_surveillance/human-review-routing/scripts/run.py"},"id":"call_66eb339740d847d8a230d1ba","type":"tool_call"}],"invalid_tool_calls":[],"usage_metadata":{"input_tokens":15143,"output_tokens":89,"total_tokens":15232,"input_token_details":{},"output_token_details":{"reasoning":18}}}],"artifacts":[],"intent_context":{"intent":"task","original_query":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","normalized_query":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","routing_query":"场景：视频监控。场景ID：video_surveillance。场景说明：视频监控、摄像头、监控录像、视频流、实时画面、视频帧、卡口、安防巡检、目标检测、行为识别、事件发现和监控告警分析场景。需要识别参数：视频对象、监控目标、时间范围、输出形式。用户原始问题：我将在视频监控场景中筛选出事件置信度低、摄像头画面有遮挡或涉及执法的结果，并将其全部提交至人工复核环节","scene":"video_surveillance","scene_name":"视频监控","params":{"视频对象":"","监控目标":"","时间范围":"","输出形式":""},"scene_mode":"single","scenes":["video_surveillance"],"task_spans":[{"task_span_id":"span_e343b9","text":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？"}],"planning_steps":[{"task_span_id":"span_f307c1","text":"基于视频监控管道读取并结构化解析目标检测日志与视频元数据，提取置信度低于预设基线、画面遮挡面积占比超过阈值或行为标签匹配执法相关关键字的原始记录，生成包含时间戳、设备ID及视频片段索引的待核查事件清单。"},{"task_span_id":"span_64e1ce","text":"对照安防巡检业务SOP与操作规范，逐项判定三类触发条件是否满足强制人工复核标准，明确各条件下的复核深度要求（如截图确认或完整录像回溯）及责任归属节点，输出分级复核规则矩阵。"},{"task_span_id":"span_ecf86c","text":"检索行业安防管理规范、个人信息保护法及内部审计指引，以强制性合规条款为基准校验必审事件目录，确保复核范围覆盖法定告知义务与数据最小必要原则，修正超界或漏审条目，输出经合规对齐的必审事件目录。"},{"task_span_id":"span_562921","text":"将合规目录重组为标准化工单结构，封装关键证据链（算法输出值、遮挡坐标图、涉法时间轴），设定流转优先级与接收智能体标识，生成可直接派发至人工复核队列的调度指令集。"}],"scene_tasks":[{"sub_task_id":"sub_ac6f14","scene":"video_surveillance","scene_name":"视频监控","text":"我将在视频监控场景中筛选出事件置信度低、摄像头画面有遮挡或涉及执法的结果，并将其全部提交至人工复核环节。","params":{}}],"sub_tasks":[{"sub_task_id":"sub_ac6f14","scene":"video_surveillance","scene_name":"视频监控","text":"我将在视频监控场景中筛选出事件置信度低、摄像头画面有遮挡或涉及执法的结果，并将其全部提交至人工复核环节。","params":{}}],"task_hints":["提取必填参数：视频对象。需要分析的监控视频、摄像头、视频流、录像文件、实时画面、卡口视频或视频帧","提取可选参数：监控目标。需要识别或分析的对象、行为或事件，如人员聚集、车辆违停、越界、烟火、异常停留、摔倒、入侵、打架、遗留物、通行计数等","提取可选参数：时间范围。视频分析的起止时间、日期、时段、时刻或实时窗口","提取可选参数：输出形式。用户期望的输出，如告警、截图、时间点清单、检测结果、表格、报告、标注说明或风险摘要"],"mentioned_skill_ids":[],"confidence":0.9,"reason":"llm_scene_slot_rewrite","_source_message_key":"id:6578b2e5-a61d-4f1c-98b3-c8d74a94ce2d"},"routing_context":{"route_mode":"scene_filter","trigger":true,"primary_goal":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","scene_tasks":[{"scene_task_id":"task_001","segment_id":"seg_001","segment_text":"事件置信度低、摄像头画面有遮挡或事件涉及执法时，哪些结果必须进入人工复核？","scene":"video_surveillance","input_refs":[],"task_types":[],"selected_skills":[{"id":"analyze-video","role":"primary","score":1.0,"reason":null},{"id":"batch-video-ingestion","role":"supporting","score":1.0,"reason":null},{"id":"camera-health-check","role":"supporting","score":1.0,"reason":null},{"id":"city-video-intelligence","role":"supporting","score":1.0,"reason":null},{"id":"duplicate-event-merge","role":"supporting","score":1.0,"reason":null},{"id":"evidence-package-generation","role":"supporting","score":1.0,"reason":null},{"id":"evidence-snapshot","role":"supporting","score":1.0,"reason":null},{"id":"ffmpeg-utils","role":"supporting","score":1.0,"reason":null},{"id":"frame-sampling","role":"supporting","score":1.0,"reason":null},{"id":"human-review-routing","role":"supporting","score":1.0,"reason":null},{"id":"object-detection","role":"supporting","score":1.0,"reason":null},{"id":"object-statistics","role":"supporting","score":1.0,"reason":null},{"id":"object-tracking","role":"supporting","score":1.0,"reason":null},{"id":"privacy-masking","role":"supporting","score":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:6578b2e5-a61d-4f1c-98b3-c8d74a94ce2d"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"allowed_tool_names":[]}

