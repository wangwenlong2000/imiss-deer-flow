n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_007\",\n            \"label\": \"car\",\n            \"confidence\": 0.3771,\n            \"bbox\": [\n              133.49,\n              171.18,\n              207.92,\n              219.68\n            ],\n            \"model_label\": \"car\"\n          },\n          {\n            \"object_id\": \"det_0003_008\",\n            \"label\": \"car\",\n            \"confidence\": 0.3592,\n            \"bbox\": [\n              492.46,\n              170.86,\n              537.31,\n              210.44\n            ],\n            \"model_label\": \"car\"\n          }\n        ]\n      }\n    ],\n    \"model\": \"/mnt/skills/custom/video_surveillance/models/yolov8n.pt\"\n  }\n}\n","additional_kwargs":{},"response_metadata":{},"type":"tool","name":"read_file","id":"b92eda3d-c2a0-4bdd-b43c-2c994b437a64","tool_call_id":"call_b80febfd8f8448adb5249236","artifact":null,"status":"success"},{"content":"现在查看抽帧画面，进行画质评估和异常识别。\n\n","additional_kwargs":{"refusal":null},"response_metadata":{"token_usage":{"completion_tokens":322,"prompt_tokens":21388,"total_tokens":21710,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":28,"rejected_prediction_tokens":null,"text_tokens":322},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":null,"text_tokens":21388}},"model_provider":"openai","model_name":"qwen3.6-35b-a3b","system_fingerprint":null,"id":"chatcmpl-b1b5e617-6d97-9adf-af13-02c4fa13f601","finish_reason":"tool_calls","logprobs":null},"type":"ai","name":null,"id":"lc_run--019f9dcc-5519-71c3-940b-141e9e3affe0-0","tool_calls":[{"name":"view_image","args":{"image_path":"/mnt/user-data/workspace/video-object-analytics/c1f323605081/frames/frames/CAM_DEERFLOW_001/CAM_DEERFLOW_001_202605201000000800_0001.jpg"},"id":"call_95afcf8b28864bddb45e1319","type":"tool_call"},{"name":"view_image","args":{"image_path":"/mnt/