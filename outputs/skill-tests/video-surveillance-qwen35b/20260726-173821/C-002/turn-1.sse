pporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:42b7568c-5f0a-49db-8225-752f2191f8b1"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill_ids":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","obj