e":1.0,"reason":null},{"id":"roi-mapping","role":"supporting","score":1.0,"reason":null},{"id":"single-video-event-analysis","role":"supporting","score":1.0,"reason":null},{"id":"video-embedding-index","role":"supporting","score":1.0,"reason":null},{"id":"video-object-analytics","role":"supporting","score":1.0,"reason":null},{"id":"video-search","role":"supporting","score":1.0,"reason":null},{"id":"video-segment-extraction","role":"supporting","score":1.0,"reason":null},{"id":"video-stream-ingestion","role":"supporting","score":1.0,"reason":null}],"expected_outputs":[],"depends_on":[]}],"global_selected_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"default_public_skill_ids":[],"global_allowed_tools":[],"confidence":1.0,"route_reason":"SkillRouter disabled; injected all custom skills for detected intent scene as LeadAgent candidate skills","allowed_skills":["analyze-video","batch-video-ingestion","camera-health-check","city-video-intelligence","duplicate-event-merge","evidence-package-generation","evidence-snapshot","ffmpeg-utils","frame-sampling","human-review-routing","object-detection","object-statistics","object-tracking","privacy-masking","roi-mapping","single-video-event-analysis","video-embedding-index","video-object-analytics","video-search","video-segment-extraction","video-stream-ingestion"],"selection_owner":"lead_agent","_source_message_key":"id:b5d1e8e5-9c98-4b90-8c17-19be4e0696d1"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"