l Loading Priority Rules:**\n- If a request clearly matches an available skill and also includes uploaded files, load the skill file before reading uploaded data files.\n- Do NOT read a full uploaded structured data file before loading the matched skill.\n- For uploaded structured data files, use small previews only when needed.\n- Prefer the matched skill's scripts, workflows, or tools for actual analysis.\n- Do not start by generating ad hoc JS, Python, SQL, or shell scripts when a matched skill exists.\n- Only improvise custom code after loading the matched skill and confirming the skill does not already provide a suitable workflow.\n\n**Skills are located at:** /mnt/skills\n\n<available_skills>\n</available_skills>\n\n</skill_system>","additional_kwargs":{"message_type":"routed_skill_prompt","internal":true},"response_metadata":{},"type":"human","name":"routing_skill_guidance","id":"e57e4679-ac9f-4f0a-bf2b-fbe7fd00b479"}],"artifacts":[],"intent_context":{"intent":"capability_inventory","original_query":"我想确认具体人员身份、读取模糊车牌、生成全市热力图并接入实时 RTSP，但当前数据只有本地视频和检测框。请说明哪些能力无法由现有数据支持，不要编造结果。","normalized_query":"我想确认具体人员身份、读取模糊车牌、生成全市热力图并接入实时 rtsp，但当前数据只有本地视频和检测框。请说明哪些能力无法由现有数据支持，不要编造结果。","routing_query":"列出当前前端授权范围内可用的技能能力。用户原始问题：我想确认具体人员身份、读取模糊车牌、生成全市热力图并接入实时 RTSP，但当前数据只有本地视频和检测框。请说明哪些能力无法由现有数据支持，不要编造结果。","scene":null,"scene_name":null,"params":{},"scene_mode":null,"scenes":[],"task_spans":[],"planning_steps":[],"scene_tasks":[],"sub_tasks":[],"task_hints":[],"mentioned_skill_ids":[],"confidence":0.85,"reason":"capability_inventory","_source_message_key":"id:03598f8c-02fb-4348-8e97-57e43b5cd4f2"},"routing_context":{"trigger":false,"route_reason":"No intent scene for scene skill filter","_source_message_key":"id:03598f8c-02fb-4348-8e97-57e43b5cd4f2"},"dialogue_context":{"act":"new_task","confidence":0.7,"reason":"no_pending_action_match","parsed_answer":null,"pending_action_id":null,"resume_intent_context":null,"resume_routing_context":null,"metadata":{}},"final_scope_skill